<script server>
const nodePath = require('node:path')
const session = await import(nodePath.join(process.cwd(), 'app/Support/session.ts'))
const board = await import(nodePath.join(process.cwd(), 'app/Support/dashboard.ts'))
const account = await import(nodePath.join(process.cwd(), 'app/Support/account.ts'))
const catalog = await import(nodePath.join(process.cwd(), 'app/Support/catalog.ts'))
const fieldmap = await import(nodePath.join(process.cwd(), 'app/Support/fieldmap.ts'))

const title = 'Your farm - Open Farming'
const description = 'Your fields, your flights and the treatment maps that came out of them.'
const activeNav = 'account'
const pagePath = '/dashboard'
const ogCard = 'account'

const farmer = await session.currentUser()
const data = farmer ? await board.dashboardFor(farmer.id) : null

// A farmer whose first flight has not happened yet still gets a dashboard:
// their booked visits, and the demonstration field as the worked example of
// what lands here afterwards.
const visits = farmer ? await account.visitsFor(farmer.email) : []
const report = farmer ? await catalog.fieldReport() : null

// The imagery panel. The same renderer the field report uses, so the picture
// on the dashboard is the picture behind the numbers rather than a stock
// photograph of somebody else's field.
const mapSvg = report ? fieldmap.renderFieldMap(report, { title: report.field, markerScale: 0.8 }) : ''

const treatedShare = data?.totals?.hectares
  ? Math.round((data.totals.treatedHectares / data.totals.hectares) * 100)
  : 0
</script>

@layout('layouts/site')

@section('content')

@if (farmer)
  <!-- A console rather than a marketing page: a rail of sections on the left,
      a header row, then a grid of cards. Wide and light, with one card
      carrying the accent so the eye lands on the number that matters. -->
  <section class="mx-auto px-3 py-6 sm:px-5 max-w-[1500px] console">
    <div class="console-shell">
      <nav class="console-rail" aria-label="{t:dashboard.sections}">
        <a href="/dashboard" class="is-active rail-item" aria-current="page" aria-label="{t:dashboard.overview}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4v-5h-6v5H5a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
        </a>
        <a href="/field-report" class="rail-item" aria-label="{t:nav.fieldReport}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="3.5" width="14" height="17" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </a>
        <a href="/features" class="rail-item" aria-label="{t:nav.capabilities}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.7"/><path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </a>
        <a href="/use-cases" class="rail-item" aria-label="{t:nav.useCases}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7.5 9.5 5l5 2.5L20 5v11.5L14.5 19l-5-2.5L4 19z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9.5 5v11.5M14.5 7.5V19" stroke="currentColor" stroke-width="1.7"/></svg>
        </a>
        <a href="/account" class="rail-item rail-item-last" aria-label="{t:dashboard.settings}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="9" r="3.4" stroke="currentColor" stroke-width="1.7"/><path d="M5.5 19.5c1.1-3 3.6-4.5 6.5-4.5s5.4 1.5 6.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </a>
      </nav>

      <div class="console-body">
        <header class="console-head">
          <div>
            <h1 class="text-[1.5rem] sm:text-[1.75rem]">{{ data.farm ? data.farm.name : farmer.name }}</h1>
            <p class="mt-1 text-[0.85rem] text-[var(--text-3)]">{{ data.farm ? data.farm.region : farmer.email }}</p>
          </div>

          <div class="flex flex-wrap gap-2 items-center">
            @if (data.totals.detections)
              <span class="console-chip">
                <span class="console-dot"></span>
                {{ data.totals.detections }} {t:dashboard.detections}
              </span>
            @endif
            <a href="/contact" class="console-chip console-chip-link">{t:cta.book}</a>
          </div>
        </header>

        @if (data.farm)
          <div class="console-grid">
            <!-- The accent card: the one number that says whether any of this
                paid for itself. -->
            <article class="console-card console-card-accent">
              <p class="console-card-label">{t:dashboard.treated}</p>
              <p class="console-metric">{{ data.totals.treatedHectares }}<span class="console-unit">ha</span></p>
              <p class="console-note">{{ treatedShare }}{t:dashboard.ofHectaresFlown}</p>
            </article>

            <article class="console-card">
              <p class="console-card-label">{t:dashboard.fields}</p>
              <p class="console-metric">{{ data.totals.fields }}</p>
              <p class="console-note">{t:dashboard.fieldsNote}</p>
            </article>

            <article class="console-card">
              <p class="console-card-label">{t:dashboard.hectares}</p>
              <p class="console-metric">{{ data.totals.hectares }}<span class="console-unit">ha</span></p>
              <p class="console-note">{t:dashboard.hectaresNote}</p>
            </article>

            <article class="console-card">
              <p class="console-card-label">{t:dashboard.detections}</p>
              <p class="console-metric">{{ data.totals.detections }}</p>
              <p class="console-note">{t:dashboard.detectionsNote}</p>
            </article>
          </div>

          <div class="console-panels">
            <!-- Imagery, the way the reference puts a camera feed beside the
                numbers: here it is the field itself, drawn from the flight. -->
            <section class="console-panel console-panel-map">
              <div class="console-panel-head">
                <h2 class="console-panel-title">{t:dashboard.mapTitle}</h2>
                <a href="/field-report" class="console-panel-link" aria-label="{t:account.openReport}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
              <div class="console-map">{!! mapSvg !!}</div>
              <div class="console-legend">
                <span><span class="legend-swatch" style="background:var(--accent)"></span>{t:fieldReport.legendZone}</span>
                <span><span class="legend-swatch" style="background:var(--crop-soft);border:1px solid var(--crop)"></span>{t:fieldReport.legendCrop}</span>
              </div>
            </section>

            <section class="console-panel">
              <div class="console-panel-head">
                <h2 class="console-panel-title">{t:dashboard.fieldsTitle}</h2>
              </div>

              @if (data.fields.length)
                <ul class="console-list">
                  @foreach (data.fields as field)
                    <li class="console-row">
                      <span class="console-status"></span>
                      <div class="min-w-0">
                        <p class="console-row-title">{{ field.name }}</p>
                        <p class="console-row-meta">{{ field.crop }} · {{ field.hectares }} ha · {{ field.lastFlown }}</p>
                      </div>
                      <span class="console-count">{{ field.detections }}</span>
                    </li>
                  @endforeach
                </ul>
              @else
                <p class="console-empty">{t:dashboard.noFields}</p>
              @endif
            </section>

            <section class="console-panel">
              <div class="console-panel-head">
                <h2 class="console-panel-title">{t:dashboard.flightsTitle}</h2>
                <span class="console-panel-meta">{{ data.flights.length }}</span>
              </div>

              @if (data.flights.length)
                <ul class="console-list">
                  @foreach (data.flights as flight)
                    <li class="console-task">
                      <div class="flex gap-3 items-baseline justify-between">
                        <p class="console-row-title">{{ flight.field }}</p>
                        <p class="console-row-meta">{{ flight.flownOn }}</p>
                      </div>
                      <p class="mt-1 console-row-meta">{{ flight.hectares }} ha · {{ flight.detections }} · {{ flight.status }}</p>
                    </li>
                  @endforeach
                </ul>
              @else
                <p class="console-empty">{t:dashboard.noFlights}</p>
              @endif
            </section>
          </div>
        @else
          <!-- No holding yet: the booked visits, and the demonstration flight
              as the worked example of what lands here after the first one. -->
          <div class="console-panels console-panels-empty">
            <section class="console-panel">
              <div class="console-panel-head">
                <h2 class="console-panel-title">{t:account.visitsTitle}</h2>
              </div>

              @if (visits.length)
                <ul class="console-list">
                  @foreach (visits as visit)
                    <li class="console-task">
                      <div class="flex gap-3 items-baseline justify-between">
                        <p class="console-row-title">{{ visit.farmName }}</p>
                        <p class="console-row-meta">{{ visit.requestedOn }}</p>
                      </div>
                      <p class="mt-1 console-row-meta">{{ visit.summary }}</p>
                      <span class="console-badge">{{ visit.status }}</span>
                    </li>
                  @endforeach
                </ul>
              @else
                <p class="console-empty">{t:account.noVisits}</p>
                <a href="/contact" class="inline-flex items-center mt-5 px-5 py-3 font-semibold no-underline text-[0.95rem] text-white bg-[var(--accent)] rounded-[10px]">{t:cta.book}</a>
              @endif
            </section>

            <section class="console-panel console-panel-map">
              <div class="console-panel-head">
                <h2 class="console-panel-title">{t:account.reportTitle}</h2>
                <a href="/field-report" class="console-panel-link" aria-label="{t:account.openReport}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
              <div class="console-map">{!! mapSvg !!}</div>
              @if (report)
                <div class="console-grid console-grid-tight">
                  <article class="console-card">
                    <p class="console-card-label">{t:account.hectares}</p>
                    <p class="console-metric">{{ report.hectares }}<span class="console-unit">ha</span></p>
                  </article>
                  <article class="console-card console-card-accent">
                    <p class="console-card-label">{t:account.treated}</p>
                    <p class="console-metric">{{ report.treatedHectares }}<span class="console-unit">ha</span></p>
                  </article>
                </div>
              @endif
            </section>
          </div>
        @endif
      </div>
    </div>
  </section>
@else
  <section class="mx-auto pb-24 pt-14 px-5 md:pt-20 max-w-[1240px]">
    <div class="max-w-[46ch]">
      <p class="font-semibold text-[0.78rem] text-[var(--accent)] tracking-[0.14em] uppercase">{t:dashboard.eyebrow}</p>
      <h1 class="mt-4 leading-[1.07] text-[2.1rem] sm:text-[2.5rem]">{t:account.signedOutTitle}</h1>
      <p class="mt-5 leading-relaxed text-[1.05rem] text-[var(--text-2)]">{t:account.signedOutBody}</p>

      <div class="flex flex-wrap gap-3 mt-8">
        <a href="/login" class="inline-flex items-center px-5 py-3 font-semibold no-underline text-[0.95rem] text-white bg-[var(--accent)] rounded-[10px]">{t:auth.signIn}</a>
        <a href="/register" class="inline-flex items-center px-5 py-3 font-semibold no-underline text-[0.95rem] text-[var(--text)] border border-[var(--line)] rounded-[10px]">{t:auth.signUp}</a>
      </div>
    </div>
  </section>
@endif

@endsection
