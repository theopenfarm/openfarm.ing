          <p class="mt-4 text-[0.78rem] text-[var(--text-3)] telemetry">{{ group.items.length }} capabilities</p>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 m-0 p-0 list-none">
          @foreach (group.items as item)
            <li>
              <a href="/features/{{ item.slug }}" class="block p-6 h-full no-underline bg-[var(--panel)] border border-[var(--line)] rounded-[10px] hover:border-[var(--accent)] transition-colors">
                <h3 class="text-[1.1rem]">{{ item.name }}</h3>
                <p class="mt-1 font-semibold text-[0.85rem] text-[var(--accent)]">{{ item.tagline }}</p>
                <p class="mt-2.5 leading-relaxed text-[0.9rem] text-[var(--text-2)]">{{ item.summary }}</p>
                <p class="mt-4 text-[0.75rem] text-[var(--text-3)] telemetry">{{ item.cadence }}</p>
              </a>
            </li>
          @endforeach
        </ul>
      </div>
    </div>
  </section>
@endforeach

