<script server>
const nodePath = require('node:path')
const session = await import(nodePath.join(process.cwd(), 'app/Support/session.ts'))

const title = 'Sign in - Open Farming'
const description = 'Sign in to see your flights, your detections and the treatment maps that came out of them.'
const activeNav = 'account'
const pagePath = '/login'
const ogCard = 'account'

// A farmer who is already signed in has no business on this page.
const farmer = await session.currentUser()

// Which providers this deployment can offer, read from config rather than
// hardcoded: a site without credentials shows the password form alone.
const social = await import(nodePath.join(process.cwd(), 'app/Support/social.ts'))
const socials = {
  google: social.providerConfigured('google'),
  apple: social.providerConfigured('apple'),
  any: social.anyProviderConfigured(),
}

// The form posts here on failure with a reason in the query string. Reading
// it needs the request URL, which `requestContext` carries; a page rendered
// outside a request (a build, a test) simply has no reason.
const requestUrl = (typeof requestContext !== 'undefined' && requestContext.url) ? requestContext.url() : ''
const reason = requestUrl.includes('e=locked') ? 'locked' : (requestUrl.includes('e=failed') ? 'failed' : '')
</script>

@layout('layouts/site')

@section('content')

<section class="mx-auto pb-24 pt-14 px-5 md:pt-20 max-w-[1240px]">
  <div class="grid gap-12 lg:gap-20 lg:grid-cols-[1fr_0.9fr]">
    <div>
      <p class="font-semibold text-[0.78rem] text-[var(--accent)] tracking-[0.14em] uppercase">{t:auth.eyebrow}</p>
      <h1 class="mt-4 max-w-[15ch] leading-[1.07] text-[2.1rem] sm:text-[2.5rem] lg:text-[2.9rem]">{t:auth.signInTitle}</h1>
      <p class="mt-5 max-w-[46ch] leading-relaxed text-[1.075rem] text-[var(--text-2)]">{t:auth.signInLede}</p>

      <ul class="mt-9 p-0 list-none border-[var(--line)] border-l-2">
        <li class="relative pb-6 pl-7">
          <span class="absolute left-[-0.4rem] top-[0.45rem] h-3 w-3 bg-[var(--accent)] rounded-[6px]"></span>
          <p class="font-semibold text-[0.97rem]">{t:auth.point1}</p>
          <p class="mt-1 leading-relaxed text-[0.92rem] text-[var(--text-2)]">{t:auth.point1Body}</p>
        </li>
        <li class="relative pb-6 pl-7">
          <span class="absolute left-[-0.4rem] top-[0.45rem] h-3 w-3 bg-[var(--accent)] rounded-[6px]"></span>
          <p class="font-semibold text-[0.97rem]">{t:auth.point2}</p>
          <p class="mt-1 leading-relaxed text-[0.92rem] text-[var(--text-2)]">{t:auth.point2Body}</p>
        </li>
        <li class="relative pl-7">
          <span class="absolute left-[-0.4rem] top-[0.45rem] h-3 w-3 bg-[var(--accent)] rounded-[6px]"></span>
          <p class="font-semibold text-[0.97rem]">{t:auth.point3}</p>
          <p class="mt-1 leading-relaxed text-[0.92rem] text-[var(--text-2)]">{t:auth.point3Body}</p>
        </li>
      </ul>
    </div>

    <div class="p-7 md:p-9 h-fit bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">
      @if (farmer)
        <h2 class="text-[1.25rem]">{t:auth.alreadyIn}</h2>
        <p class="mt-3 leading-relaxed text-[0.95rem] text-[var(--text-2)]">{{ farmer.email }}</p>
        <a href="/dashboard" class="inline-flex items-center justify-center mt-6 px-5 py-3 w-full font-semibold no-underline text-[0.95rem] text-white bg-[var(--accent)] rounded-[10px]">{t:auth.toAccount}</a>
      @else
        @if (reason === 'locked')
          <!-- Deliberately the same wording for a locked account as for a
              wrong password would be too vague to act on: a farmer who is
              locked out needs to know waiting is the fix. -->
          <p class="mb-5 p-3.5 text-[0.88rem] text-[var(--text)] bg-[var(--accent-wash)] border border-[var(--accent)] rounded-[10px]">{t:auth.locked}</p>
        @endif
        @if (reason === 'failed')
          <p class="mb-5 p-3.5 text-[0.88rem] text-[var(--text)] bg-[var(--accent-wash)] border border-[var(--accent)] rounded-[10px]">{t:auth.failed}</p>
        @endif

        <!-- Server-rendered and plain: the form works before any script has
            loaded, which on a field connection is the difference between
            signing in and not. -->
        <form method="post" action="/api/auth/sign-in">
          <div class="grid gap-5">
            <div class="grid gap-2">
              <label for="email" class="font-semibold text-[0.88rem]">{t:auth.email}</label>
              <input id="email" name="email" type="email" required autocomplete="email" autofocus
                class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
            </div>

            <div class="grid gap-2">
              <label for="password" class="font-semibold text-[0.88rem]">{t:auth.password}</label>
              <input id="password" name="password" type="password" required autocomplete="current-password"
                class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
            </div>

            <button type="submit" class="px-5 py-3 w-full font-semibold text-[0.95rem] text-white bg-[var(--accent)] border-0 rounded-[10px] cursor-pointer">{t:auth.signIn}</button>
          </div>
        </form>


        <!-- Always rendered. A provider without credentials answers with a
            message rather than a dead end, and hiding the buttons until the
            keys land makes the page look like it has no social sign-in at
            all. -->
          <div class="grid gap-2.5 mt-6">
              <a href="/api/auth/google/redirect" class="inline-flex gap-2.5 items-center justify-center px-5 py-3 font-semibold no-underline text-[0.93rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
                <svg width="17" height="17" viewBox="0 0 18 18" aria-hidden="true">
                  <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
                  <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
                  <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/>
                  <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.46 3.44 1.35l2.58-2.58C13.46.9 11.42 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
                </svg>
                {t:auth.google}
              </a>
              <a href="/api/auth/apple/redirect" class="inline-flex gap-2.5 items-center justify-center px-5 py-3 font-semibold no-underline text-[0.93rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
                <svg width="16" height="16" viewBox="0 0 16 20" aria-hidden="true" fill="currentColor">
                  <path d="M13.2 10.6c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.8-3.1.8-.6 0-1.6-.8-2.7-.7-1.4 0-2.7.8-3.4 2-1.4 2.5-.4 6.2 1 8.2.7 1 1.5 2.1 2.5 2 1 0 1.4-.6 2.6-.6s1.6.6 2.7.6c1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3 0 0-2-.8-2-3.2zM11.2 3.9c.5-.7.9-1.6.8-2.6-.8 0-1.8.5-2.4 1.2-.5.6-1 1.6-.8 2.5.9.1 1.8-.4 2.4-1.1z"/>
                </svg>
                {t:auth.apple}
              </a>
          </div>

          <p class="mt-3 text-[0.78rem] text-[var(--text-3)]">{t:auth.socialNote}</p>

        <p class="mt-6 text-[0.88rem] text-[var(--text-2)]">
          {t:auth.noAccount} <a href="/register" class="font-semibold text-[var(--accent)]">{t:auth.signUp}</a>
        </p>
      @endif
    </div>
  </div>
</section>

@endsection
