<script server>
const nodePath = require('node:path')
const catalog = await import(nodePath.join(process.cwd(), 'app/Support/catalog.ts'))

const title = 'Use cases - Open Farming'
const description = 'How the platform is set up for cereals, maize, beet, potatoes, vines, orchards, berries, hops, grassland, dairy, glasshouses, organic rotations, contractors, cooperatives and restoration.'
const activeNav = 'use-cases'
const pagePath = '/use-cases'

const groups = await catalog.displayUseCaseGroups()
const total = groups.reduce((n, g) => n + g.items.length, 0)

// One photograph per segment, chosen because it shows the ground being
// described rather than to decorate the row.
const segmentPhotos = {
  arable: { src: '/images/photos/field-aerial.jpg', alt: 'Aerial view of a cereal field divided by a track' },
  permanent: { src: '/images/photos/vineyard-aerial.jpg', alt: 'Aerial view of vineyard rows following a slope' },
  protected: { src: '/images/photos/farm-patchwork.jpg', alt: 'Aerial view of a patchwork of cultivated blocks' },
  livestock: { src: '/images/photos/grassland-aerial.jpg', alt: 'Aerial view of a cut grass field' },
  operator: { src: '/images/photos/drone-over-wheat.jpg', alt: 'A drone flying low over a wheat crop' },
}
const groupsWithPhoto = groups.map(g => ({ ...g, photo: segmentPhotos[g.key] }))
</script>

@layout('layouts/site')

@section('content')

<section class="mx-auto pb-12 pt-14 px-5 md:pt-20 max-w-[1240px]">
  <h1 class="max-w-[20ch] leading-[1.07] text-[2.1rem] sm:text-[2.6rem] lg:text-[3rem]">
    The same platform, set up {{ total }} different ways
  </h1>
  <p class="mt-5 max-w-[62ch] leading-relaxed text-[1.075rem] text-[var(--text-2)]">
    A wheat field and a hop yard have almost nothing in common except that both are flown. Each
    operation below has its own flight calendar, its own instruments and its own set of things
    worth looking for.
  </p>
</section>

@foreach (groupsWithPhoto as group)
  <section class="py-14 md:py-16 border-[var(--line)] border-t reveal">
    <div class="mx-auto px-5 max-w-[1240px]">
      <div class="grid gap-8 lg:gap-14 lg:grid-cols-[18rem_1fr]">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <img src="{{ group.photo.src }}" alt="{{ group.photo.alt }}" width="576" height="324" loading="lazy" class="object-cover h-36 w-full border border-[var(--line)] rounded-[10px]">
          <h2 class="mt-5 text-[1.6rem]">{{ group.label }}</h2>
          <p class="mt-2 leading-relaxed text-[0.95rem] text-[var(--text-2)]">{{ group.blurb }}</p>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 m-0 p-0 list-none">
          @foreach (group.items as item)
            <li>
              <a href="/use-cases/{{ item.slug }}" class="block p-6 h-full no-underline bg-[var(--panel)] border border-[var(--line)] rounded-[10px] hover:border-[var(--accent)] transition-colors">
                <h3 class="text-[1.1rem]">{{ item.name }}</h3>
                <p class="mt-1 font-semibold text-[0.85rem] text-[var(--accent)]">{{ item.tagline }}</p>
                <p class="mt-2.5 leading-relaxed text-[0.9rem] text-[var(--text-2)]">{{ item.summary }}</p>
                <p class="mt-4 text-[0.75rem] text-[var(--text-3)] telemetry">{{ item.scale }}</p>
              </a>
            </li>
          @endforeach
        </ul>
      </div>
    </div>
  </section>
@endforeach

<section class="mx-auto px-5 py-16 max-w-[1240px] reveal">
  <div class="flex flex-wrap gap-6 items-center justify-between p-8 md:p-11 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">
    <div>
      <h2 class="max-w-[24ch] text-[1.6rem] md:text-[1.9rem]">Your rotation is not on this list</h2>
      <p class="mt-2 max-w-[52ch] leading-relaxed text-[0.98rem] text-[var(--text-2)]">
        Most of it still applies. Tell us the crop and the hectares and we will say plainly which
        capabilities earn their keep and which do not.
      </p>
    </div>
    <a href="/contact" class="btn btn-primary">Book a field visit</a>
  </div>
</section>

@endsection
