<script server>
// Fallback page meta. Every page sets these in its own server script and
// those values win; this only fills the gaps.
const title = 'Open Farming'
const description = 'Autonomous drone scouting for farms. Scan the field, find the problem, treat only the square metres that need it.'
const pagePath = typeof pagePath === 'string' ? pagePath : '/'
const activeNav = typeof activeNav === 'string' ? activeNav : ''
const siteUrl = 'https://openfarm.ing'
const canonicalUrl = `${siteUrl}${pagePath === '/' ? '/' : pagePath}`

// Every page has its own card, carrying that page's headline. The file mirrors
// the URL (`/use-cases/vineyards` -> `use-cases/vineyards.jpg`), so a new page
// gets one from `buddy og:generate` without anything here changing. `ogCard`
// overrides it for pages whose card is named differently.
// Plain expressions rather than an IIFE: stx evaluates the server script in a
// scope where a self-invoking function silently yields undefined, which put
// `og/undefined.jpg` on every page.
//
// Every page has its own card carrying that page's headline, and the file
// mirrors the URL (`/use-cases/vineyards` -> `use-cases/vineyards.jpg`), so a
// new page gets one from `buddy og:generate` with nothing to change here.
// `ogCard` overrides it for pages whose card is named differently.
const ogPathSlug = pagePath.split('/').filter(Boolean).join('/') || 'home'
const ogSlug = typeof ogCard === 'string' && ogCard ? ogCard : ogPathSlug
// `{t:og.localePrefix}` resolves to '' in English and 'de/' or 'nl/' in the
// other two, which is exactly where `buddy og:generate` writes each locale's
// cards. It has to be a token rather than a value from this script: the
// script runs once, and the locale is only known to the translation pass that
// runs over the finished HTML. So a shared /de/ URL puts a German card in the
// feed, which is the whole point of translating them.
const ogImage = `${siteUrl}/images/og/{t:og.localePrefix}${ogSlug}.jpg`

// Locale alternates. stx serves the same page under /de and /nl, and without
// these a crawler treats the three as unrelated near-duplicates.
const localePath = pagePath === '/' ? '/' : pagePath
const alternates = [
  { hreflang: 'en', href: `${siteUrl}${localePath}` },
  { hreflang: 'de', href: `${siteUrl}/de${localePath === '/' ? '/' : localePath}` },
  { hreflang: 'nl', href: `${siteUrl}/nl${localePath === '/' ? '/' : localePath}` },
  { hreflang: 'x-default', href: `${siteUrl}${localePath}` },
]
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f3f5ef" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0c0f0b" media="(prefers-color-scheme: dark)">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Open Farming">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ title }}">
  <meta property="og:locale" content="en_GB">
  <meta property="og:locale:alternate" content="de_DE">
  <meta property="og:locale:alternate" content="nl_NL">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ ogImage }}">
  <meta name="twitter:image:alt" content="{{ title }}">

  @foreach (alternates as alternate)
    <link rel="alternate" hreflang="{{ alternate.hreflang }}" href="{{ alternate.href }}">
  @endforeach

  <!-- Two mechanisms, because browsers split on which they honour. Chrome and
      Firefox run the media query inside favicon.svg; Safari does not, and
      takes the scheme from these `media` attributes instead. Either way the
      plate follows the tab chrome and the accent marks stay put. The
      unqualified link last is the fallback for anything that reads neither. -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" media="(prefers-color-scheme: light)">
  <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/images/og/home.jpg">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta name="author" content="Open Farming">

  <link rel="preload" href="/fonts/satoshi/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/site.css">
  <script>
    /*
     * Theme, resolved before first paint so the page never flashes the wrong
     * one. A saved choice wins; otherwise the operating system decides, which
     * is what prefers-color-scheme is for. Everything downstream reads CSS
     * custom properties, so this one class is the entire switch.
     */
    ;(function () {
      var saved = ''
      try { saved = localStorage.getItem('of-theme') || '' } catch (e) {}
      var dark = saved === 'dark' || (saved !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches)
      document.documentElement.classList.toggle('dark', dark)

      /*
       * Close a mega menu once one of its links is followed.
       *
       * Lives here beside the theme switch rather than in an stx `<script
       * client>` block because stx binds its event directives inside
       * client-rendered subtrees only, and this navigation is server-rendered
       * markup.
       *
       * `pointerleave` is bound to each panel rather than delegated from the
       * document: it fires for every element the pointer leaves, so a
       * delegated listener cleared the dismissed flag continuously while the
       * cursor moved *inside* the panel, and the menu flickered as it fought
       * the `:hover` rule. Bound directly, it fires once, when the pointer
       * actually leaves the whole thing.
       */
      function bindMegaMenus() {
        document.querySelectorAll('.has-mega').forEach(function (panel) {
          if (panel.dataset.megaBound === '1') return
          panel.dataset.megaBound = '1'

          panel.addEventListener('click', function (event) {
            if (event.target.closest('.mega a')) panel.classList.add('mega-dismissed')
          })

          panel.addEventListener('pointerleave', function () {
            panel.classList.remove('mega-dismissed')
          })
        })
      }

      // Keyboard users close it with Escape, which also drops focus so
      // :focus-within stops holding it open.
      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return
        var open = document.querySelector('.has-mega:focus-within')
        if (!open) return
        open.classList.add('mega-dismissed')
        if (document.activeElement && document.activeElement.blur) document.activeElement.blur()
      })

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindMegaMenus)
      else bindMegaMenus()
      document.addEventListener('stx:load', bindMegaMenus)
      window.addEventListener('stx:navigate', bindMegaMenus)

      window.ofToggleTheme = function () {
        var next = document.documentElement.classList.contains('dark') ? 'light' : 'dark'
        try { localStorage.setItem('of-theme', next) } catch (e) {}
        document.documentElement.classList.toggle('dark', next === 'dark')
        var b = document.querySelector('[data-theme-toggle]')
        if (b) b.setAttribute('aria-label', next === 'dark' ? 'Switch to light theme' : 'Switch to dark theme')
      }
    })()
  </script>
  @stack('head')
</head>
<body>
  <a href="#main" class="focus:absolute focus:z-[60] focus:m-3 focus:px-4 focus:py-2 focus:bg-[var(--panel)] focus:rounded-[10px] sr-only focus:not-sr-only">{t:nav.skip}</a>

  @include('nav.stx')

  <main id="main">
    @yield('content')
  </main>

  @include('footer.stx')

  @stack('scripts')
</body>
</html>
