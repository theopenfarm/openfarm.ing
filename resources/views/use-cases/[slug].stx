<script server>
const nodePath = require('node:path')
const catalog = await import(nodePath.join(process.cwd(), 'app/Support/catalog.ts'))

const slug = String((typeof params === 'object' && params && params.slug) || '').replace(/[^a-z0-9-]/gi, '')
const useCase = await catalog.displayUseCase(slug)

const title = useCase ? `${useCase.name} - Open Farming` : 'Use case not found - Open Farming'
const description = useCase ? useCase.summary : 'That use case does not exist. Browse all sixteen instead.'
const activeNav = 'use-cases'
const pagePath = `/use-cases/${slug}`

// Resolved in the order the use case lists them, most load bearing first, so
// the page leads with the capability that matters most here.
const allFeatures = useCase ? await catalog.displayFeatures() : []
const usedFeatures = useCase
  ? useCase.features.map(s => allFeatures.find(f => f.slug === s)).filter(Boolean)
  : []
// The token the translation pass resolves, not the English label: a
// German page was showing an English badge over a German headline.
const segmentLabel = useCase ? `{t:groups.useCases.${useCase.segment}.label}` : ''

const siblings = useCase
  ? (await catalog.displayUseCases()).filter(u => u.segment === useCase.segment && u.slug !== useCase.slug)
  : []

const segmentPhotos = {
  arable: { src: '/images/photos/field-aerial.jpg', alt: 'Aerial view of a cereal field divided by a track' },
  permanent: { src: '/images/photos/vineyard-aerial.jpg', alt: 'Aerial view of vineyard rows following a slope' },
  protected: { src: '/images/photos/farm-patchwork.jpg', alt: 'Aerial view of a patchwork of cultivated blocks' },
  livestock: { src: '/images/photos/grassland-aerial.jpg', alt: 'Aerial view of a cut grass field' },
  operator: { src: '/images/photos/drone-over-wheat.jpg', alt: 'A drone flying low over a wheat crop' },
}
const photo = useCase ? segmentPhotos[useCase.segment] : null
</script>

@layout('layouts/site')

@section('content')

@if (useCase)
  <article>
    <section class="mx-auto pb-10 pt-12 px-5 md:pt-16 max-w-[1240px]">
      <a href="/use-cases" class="no-underline text-[0.85rem] text-[var(--text-2)] hover:text-[var(--text)]">{t:nav.useCases}</a>
      <div class="grid gap-10 lg:gap-14 lg:grid-cols-[1.05fr_1fr] lg:items-center mt-4">
        <div>
          <span class="chip">{{ segmentLabel }}</span>
          <h1 class="mt-4 leading-[1.07] text-[2.1rem] sm:text-[2.5rem] lg:text-[2.9rem]">{{ useCase.name }}</h1>
          <p class="mt-3 font-semibold text-[1.1rem] text-[var(--accent)]">{{ useCase.tagline }}</p>
          <p class="mt-4 max-w-[50ch] leading-relaxed text-[1.075rem] text-[var(--text-2)]">{{ useCase.summary }}</p>
          <p class="mt-5 text-[0.82rem] text-[var(--text-3)] telemetry">{{ useCase.scale }}</p>
          <a href="/contact" class="mt-7 btn btn-primary">{t:cta.book}</a>
        </div>
        <img src="{{ photo.src }}" alt="{{ photo.alt }}" width="1200" height="800" class="object-cover h-[17rem] w-full border border-[var(--line)] rounded-[10px]">
      </div>
    </section>

    <!-- The problem, then the setup. Two columns of prose, no cards. -->
    <section class="py-14 md:py-18 bg-[var(--panel)] border-[var(--line)] border-y">
      <div class="grid gap-10 md:gap-14 md:grid-cols-2 mx-auto px-5 max-w-[1240px]">
        <div>
          <h2 class="text-[1.5rem]">{t:useCaseDetail.wrong}</h2>
          <div class="mt-4 prose"><p>{{ useCase.challenge }}</p></div>
        </div>
        <div>
          <h2 class="text-[1.5rem]">{t:useCaseDetail.setup}</h2>
          <div class="mt-4 prose"><p>{{ useCase.approach }}</p></div>
        </div>
      </div>
    </section>

    <!-- The season, as a vertical timeline rather than a row of cards. -->
    <section class="mx-auto px-5 py-16 md:py-20 max-w-[1240px] reveal">
      <h2 class="max-w-[22ch] text-[1.7rem] md:text-[2.1rem]">{t:useCaseDetail.calendar}</h2>
      <ol class="mt-8 p-0 list-none border-[var(--line)] border-l-2">
        @foreach (useCase.season as stage)
          <li class="relative pb-8 pl-7 last:pb-0">
            <span class="absolute left-[-0.4rem] top-[0.45rem] h-3 w-3 bg-[var(--accent)] rounded-[6px]"></span>
            <p class="font-semibold text-[0.78rem] text-[var(--text)] tracking-[0.08em] uppercase telemetry">{{ stage.window }}</p>
            <p class="mt-1.5 max-w-[68ch] leading-relaxed text-[0.97rem] text-[var(--text-2)]">{{ stage.focus }}</p>
          </li>
        @endforeach
      </ol>
    </section>

    <!-- Capabilities in play, ordered by how much work they do here. -->
    <section class="py-16 md:py-20 bg-[var(--bg-2)] border-[var(--line)] border-y">
      <div class="mx-auto px-5 max-w-[1240px]">
        <h2 class="max-w-[24ch] text-[1.7rem] md:text-[2.1rem]">{t:useCaseDetail.inPlay}</h2>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mt-8 p-0 list-none">
          @foreach (usedFeatures as f)
            <li>
              <a href="/features/{{ f.slug }}" class="block p-6 h-full no-underline bg-[var(--panel)] border border-[var(--line)] rounded-[10px] hover:border-[var(--accent)] transition-colors">
                <h3 class="text-[1.05rem]">{{ f.name }}</h3>
                <p class="mt-1 font-semibold text-[0.84rem] text-[var(--accent)]">{{ f.tagline }}</p>
                <p class="mt-2.5 leading-relaxed text-[0.88rem] text-[var(--text-2)]">{{ f.summary }}</p>
              </a>
            </li>
          @endforeach
        </ul>
      </div>
    </section>

    <!-- What comes out, as measurements. -->
    <section class="mx-auto px-5 py-16 md:py-20 max-w-[1240px] reveal">
      <div class="grid gap-10 lg:gap-14 lg:grid-cols-[1fr_1.3fr]">
        <div>
          <h2 class="text-[1.7rem] md:text-[2.1rem]">{t:useCaseDetail.endWith}</h2>
          <p class="mt-3 max-w-[40ch] leading-relaxed text-[0.98rem] text-[var(--text-2)]">
            Recorded on your fields, flight by flight. Not a projection.
          </p>
        </div>
        <ul class="grid overflow-hidden gap-px m-0 p-0 list-none bg-[var(--line)] rounded-[10px]">
          @foreach (useCase.outcomes as outcome)
            <li class="px-6 py-5 leading-relaxed text-[0.97rem] text-[var(--text-2)] bg-[var(--panel)]">{{ outcome }}</li>
          @endforeach
        </ul>
      </div>
    </section>

    <section class="mx-auto pb-20 px-5 max-w-[1240px]">
      <div class="pt-8 border-[var(--line)] border-t">
        <p class="mega-col-title">{t:detail.moreIn} {{ segmentLabel }}</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 mt-3 p-0 list-none">
          @foreach (siblings as s)
            <li><a href="/use-cases/{{ s.slug }}" class="no-underline text-[0.95rem] text-[var(--text-2)] hover:text-[var(--accent)]">{{ s.name }}</a></li>
          @endforeach
        </ul>
      </div>
    </section>
  </article>
@else
  <section class="mx-auto px-5 py-24 max-w-[1240px]">
    <h1 class="text-[2rem]">{t:useCaseDetail.notFound}</h1>
    <p class="mt-3 max-w-[52ch] leading-relaxed text-[1.05rem] text-[var(--text-2)]">
      The link may be out of date. All sixteen operations are listed on one page.
    </p>
    <a href="/use-cases" class="mt-6 btn btn-primary">{t:useCaseDetail.seeAll}</a>
  </section>
@endif

@endsection
