<script server>
const nodePath = require('node:path')
const session = await import(nodePath.join(process.cwd(), 'app/Support/session.ts'))

const title = 'Create an account - Open Farming'
const description = 'Create an account to keep your flights, detections and treatment maps in one place.'
const activeNav = 'account'
const pagePath = '/register'
const ogCard = 'account'

const farmer = await session.currentUser()

const requestUrl = (typeof requestContext !== 'undefined' && requestContext.url) ? requestContext.url() : ''
const reason = requestUrl.includes('e=exists')
  ? 'exists'
  : (requestUrl.includes('e=weak') ? 'weak' : (requestUrl.includes('e=invalid') ? 'invalid' : ''))
</script>

@layout('layouts/site')

@section('content')

<section class="mx-auto pb-24 pt-14 px-5 md:pt-20 max-w-[1240px]">
  <div class="grid gap-12 lg:gap-20 lg:grid-cols-[1fr_0.9fr]">
    <div>
      <p class="font-semibold text-[0.78rem] text-[var(--accent)] tracking-[0.14em] uppercase">{t:auth.eyebrow}</p>
      <h1 class="mt-4 max-w-[15ch] leading-[1.07] text-[2.1rem] sm:text-[2.5rem] lg:text-[2.9rem]">{t:auth.signUpTitle}</h1>
      <p class="mt-5 max-w-[46ch] leading-relaxed text-[1.075rem] text-[var(--text-2)]">{t:auth.signUpLede}</p>

      <p class="mt-8 max-w-[44ch] leading-relaxed text-[0.92rem] text-[var(--text-2)]">{t:auth.signUpNote}</p>

      <p class="mt-6 max-w-[44ch] leading-relaxed text-[0.9rem] text-[var(--text-3)]">
        {t:auth.bookInstead} <a href="/contact" class="font-semibold text-[var(--accent)]">{t:cta.book}</a>
      </p>
    </div>

    <div class="p-7 md:p-9 h-fit bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">
      @if (farmer)
        <h2 class="text-[1.25rem]">{t:auth.alreadyIn}</h2>
        <p class="mt-3 leading-relaxed text-[0.95rem] text-[var(--text-2)]">{{ farmer.email }}</p>
        <a href="/account" class="inline-flex items-center justify-center mt-6 px-5 py-3 w-full font-semibold no-underline text-[0.95rem] text-white bg-[var(--accent)] rounded-[10px]">{t:auth.toAccount}</a>
      @else
        @if (reason === 'exists')
          <p class="mb-5 p-3.5 text-[0.88rem] text-[var(--text)] bg-[var(--accent-wash)] border border-[var(--accent)] rounded-[10px]">{t:auth.exists}</p>
        @endif
        @if (reason === 'weak')
          <p class="mb-5 p-3.5 text-[0.88rem] text-[var(--text)] bg-[var(--accent-wash)] border border-[var(--accent)] rounded-[10px]">{t:auth.weak}</p>
        @endif
        @if (reason === 'invalid')
          <p class="mb-5 p-3.5 text-[0.88rem] text-[var(--text)] bg-[var(--accent-wash)] border border-[var(--accent)] rounded-[10px]">{t:auth.invalid}</p>
        @endif

        <form method="post" action="/api/auth/sign-up">
          <div class="grid gap-5">
            <div class="grid gap-2">
              <label for="name" class="font-semibold text-[0.88rem]">{t:auth.name}</label>
              <input id="name" name="name" type="text" required autocomplete="name" autofocus
                class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
            </div>

            <div class="grid gap-2">
              <label for="email" class="font-semibold text-[0.88rem]">{t:auth.email}</label>
              <input id="email" name="email" type="email" required autocomplete="email"
                class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
            </div>

            <div class="grid gap-2">
              <label for="password" class="font-semibold text-[0.88rem]">{t:auth.password}</label>
              <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password"
                class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
              <p class="text-[0.78rem] text-[var(--text-3)]">{t:auth.passwordHelp}</p>
            </div>

            <button type="submit" class="px-5 py-3 w-full font-semibold text-[0.95rem] text-white bg-[var(--accent)] border-0 rounded-[10px] cursor-pointer">{t:auth.createAccount}</button>
          </div>
        </form>

        <p class="mt-6 text-[0.88rem] text-[var(--text-2)]">
          {t:auth.haveAccount} <a href="/login" class="font-semibold text-[var(--accent)]">{t:auth.signIn}</a>
        </p>
      @endif
    </div>
  </div>
</section>

@endsection
