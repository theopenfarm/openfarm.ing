<script server>
const nodePath = require('node:path')
const catalog = await import(nodePath.join(process.cwd(), 'app/Support/catalog.ts'))
const fieldmap = await import(nodePath.join(process.cwd(), 'app/Support/fieldmap.ts'))

const title = 'Open Farming - drone scouting and targeted treatment for farms'
const description = 'Drones scan the field, the models find the weeds, disease and dry ground, and only the affected square metres get treated. Flights booked by the season, not aircraft bought by the unit.'
const activeNav = ''
const pagePath = '/'

const groups = await catalog.displayFeatureGroups()
const useCases = await catalog.displayUseCases()
const report = await catalog.fieldReport()

// The hero map is the real prescription: boundary, tramlines, every detection
// and every treatment zone from the seeded flight.
const heroMap = report
  ? fieldmap.renderFieldMap(report, { title: `Weed map of ${report.field}: ${report.detections.length} detections and ${report.zones.length} treatment zones` })
  : ''
const zonesOnlyMap = report
  ? fieldmap.renderFieldMap(report, { title: 'Treatment zones only, without the individual detections', showDetections: false })
  : ''
const untreatedHectares = report ? Number((report.hectares - report.treatedHectares).toFixed(2)) : 0
const untreatedPercent = report ? Number((100 - report.treatedPercent).toFixed(1)) : 0
</script>

@layout('layouts/site')

@section('content')

<!-- Hero: asymmetric split. The headline argues, the map proves. -->
<section class="mx-auto pb-16 pt-14 px-5 md:pb-24 md:pt-20 max-w-[1240px]">
  <div class="grid gap-10 lg:gap-14 lg:grid-cols-[1.05fr_1fr] lg:items-center">
    <div>
      <!-- The break is forced from `sm` up so the two sentences sit on two
          lines. Below that the column is too narrow for either sentence to
          fit anyway, so it wraps naturally instead of breaking twice. -->
      <h1 class="leading-[1.08] text-[1.95rem] sm:text-[2.5rem] lg:text-[2.9rem] enter" style="--i:0">
        {t:home.headlineOne}<br class="hidden sm:inline">
        {t:home.headlineTwo}
      </h1>
      <p class="mt-5 max-w-[46ch] leading-relaxed text-[1.075rem] text-[var(--text-2)] enter" style="--i:1">
        {t:home.lede}
      </p>
      <div class="flex flex-wrap gap-3 mt-8 enter" style="--i:2">
        <a href="/contact" class="btn btn-primary">{t:cta.book}</a>
        <a href="/field-report" class="btn btn-ghost">{t:cta.readReport}</a>
      </div>
    </div>

    <div class="enter" style="--i:3">
      @if (report)
        <figure class="m-0 p-4 sm:p-5 bg-[var(--panel)] border border-[var(--line)] rounded-[10px] shadow-[var(--shadow)]">
          <div class="flex gap-4 items-baseline justify-between mb-3">
            <figcaption class="text-[0.82rem] text-[var(--text-2)]">
              <span class="font-semibold text-[var(--text)]">{{ report.field }}</span>, {{ report.crop }}, {{ report.hectares }} ha
            </figcaption>
            <span class="chip">{t:home.demoField}</span>
          </div>
          {!! heroMap !!}
          <div class="flex flex-wrap gap-x-5 gap-y-2 mt-3.5 text-[0.78rem] text-[var(--text-2)]">
            <span class="flex gap-1.5 items-center"><span class="legend-swatch" style="background:var(--accent)"></span>{t:home.treated}: {{ report.treatedHectares }} ha</span>
            <span class="flex gap-1.5 items-center"><span class="legend-swatch" style="background:var(--crop-soft);border:1px solid var(--crop)"></span>{t:home.leftAlone}: {{ untreatedHectares }} ha</span>
            <span class="ml-auto telemetry">{{ report.detections.length }} {t:home.detections}</span>
          </div>
        </figure>
      @endif
    </div>
  </div>
</section>

<!-- What that one flight measured. Hairline-separated readings, no cards. -->
@if (report)
<section class="bg-[var(--panel)] border-[var(--line)] border-y">
  <div class="grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-4 mx-auto px-5 py-9 max-w-[1240px]">
    <div>
      <p class="font-bold leading-none text-[2rem] text-[var(--accent)] telemetry">{{ report.treatedPercent }}%</p>
      <p class="mt-1.5 max-w-[26ch] text-[0.85rem] text-[var(--text-2)]">{t:home.statTreatedBefore} {{ untreatedPercent }}{t:home.statTreatedAfter}</p>
    </div>
    <div>
      <p class="font-bold leading-none text-[2rem] telemetry">{{ report.detections.length }}</p>
      <p class="mt-1.5 max-w-[26ch] text-[0.85rem] text-[var(--text-2)]">{t:home.statDetections}</p>
    </div>
    <div>
      <p class="font-bold leading-none text-[2rem] telemetry">{{ report.durationMinutes }} min</p>
      <p class="mt-1.5 max-w-[26ch] text-[0.85rem] text-[var(--text-2)]">{t:home.statFlightBefore} {{ report.hectares }} {t:home.statFlightMiddle} {{ report.resolutionCm }} {t:home.statFlightAfter}</p>
    </div>
    <div>
      <p class="font-bold leading-none text-[2rem] telemetry">{{ report.zones.length }}</p>
      <p class="mt-1.5 max-w-[26ch] text-[0.85rem] text-[var(--text-2)]">{t:home.statZones}</p>
    </div>
  </div>
</section>
@endif

<!-- The thesis: three moves, hairline separated. -->
<section class="mx-auto px-5 py-20 md:py-28 max-w-[1240px] reveal">
  <h2 class="max-w-[18ch] text-[1.9rem] md:text-[2.4rem]">{t:home.loopTitle}</h2>
  <p class="mt-4 max-w-[58ch] text-[1.02rem] text-[var(--text-2)]">
    {t:home.loopLede}
  </p>

  <ol class="grid overflow-hidden gap-px md:grid-cols-3 mt-10 p-0 list-none bg-[var(--line)] rounded-[10px]">
    <li class="p-7 bg-[var(--panel)]">
      <p class="font-semibold text-[0.75rem] text-[var(--accent)] telemetry">{t:home.scan}</p>
      <h3 class="mt-2 text-[1.15rem]">{t:home.scanTitle}</h3>
      <p class="mt-2 leading-relaxed text-[0.92rem] text-[var(--text-2)]">
        {t:home.scanBody}
      </p>
    </li>
    <li class="p-7 bg-[var(--panel)]">
      <p class="font-semibold text-[0.75rem] text-[var(--accent)] telemetry">{t:home.mark}</p>
      <h3 class="mt-2 text-[1.15rem]">{t:home.markTitle}</h3>
      <p class="mt-2 leading-relaxed text-[0.92rem] text-[var(--text-2)]">
        {t:home.markBody}
      </p>
    </li>
    <li class="p-7 bg-[var(--panel)]">
      <p class="font-semibold text-[0.75rem] text-[var(--accent)] telemetry">{t:home.treat}</p>
      <h3 class="mt-2 text-[1.15rem]">{t:home.treatTitle}</h3>
      <p class="mt-2 leading-relaxed text-[0.92rem] text-[var(--text-2)]">
        {t:home.treatBody}
      </p>
    </li>
  </ol>
</section>

<!-- Capability bento: mixed tile sizes, three treatments (map, photo, tint). -->
<section class="mx-auto pb-20 px-5 md:pb-28 max-w-[1240px] reveal">
  <div class="flex flex-wrap gap-4 items-end justify-between mb-8">
    <h2 class="max-w-[20ch] text-[1.9rem] md:text-[2.4rem]">{t:home.bentoTitle}</h2>
    <a href="/features" class="btn btn-ghost">{t:cta.allCapabilities}</a>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    @if (report)
      <article class="flex overflow-hidden flex-col md:col-span-2 md:row-span-2 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">
        <div class="p-6 pb-0">
          <span class="chip">Act</span>
          <h3 class="mt-3 text-[1.35rem]">{t:features.targeted-weed-control.name}</h3>
          <p class="mt-2 max-w-[52ch] leading-relaxed text-[0.95rem] text-[var(--text-2)]">
            Cameras find weeds plant by plant. The prescription switches the boom on over
            {{ report.treatedHectares }} hectares instead of all {{ report.hectares }}.
          </p>
        </div>
        <div class="mt-auto p-6 pt-5">
          {!! zonesOnlyMap !!}
          <a href="/features/targeted-weed-control" class="mt-5 btn btn-ghost">{t:home.mapTitle}</a>
        </div>
      </article>
    @endif

    <article class="overflow-hidden bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">
      <img src="/images/photos/drone-over-wheat.jpg" alt="A drone flying low over a wheat crop" width="800" height="533" loading="lazy" class="object-cover h-40 w-full">
      <div class="p-6">
        <span class="chip">Detect</span>
        <h3 class="mt-3 text-[1.1rem]">{t:features.plant-disease-detection.name}</h3>
        <p class="mt-2 leading-relaxed text-[0.9rem] text-[var(--text-2)]">
          Multispectral imaging reads chlorophyll loss days before a symptom is visible from the cab.
        </p>
        <a href="/features/plant-disease-detection" class="inline-block mt-3 font-semibold no-underline text-[0.875rem] text-[var(--accent)]">{t:home.flightCadence}</a>
      </div>
    </article>

    <article class="p-6 bg-[var(--accent-wash)] border border-[var(--line)] rounded-[10px]">
      <span class="chip">Detect</span>
      <h3 class="mt-3 text-[1.1rem]">{t:features.wildlife-rescue.name}</h3>
      <p class="mt-2 leading-relaxed text-[0.9rem] text-[var(--text-2)]">
        A thermal search at dawn finds fawns pressed flat in the sward, and marks them live on the
        phone of whoever is walking the field.
      </p>
      <a href="/features/wildlife-rescue" class="inline-block mt-3 font-semibold no-underline text-[0.875rem] text-[var(--accent)]">{t:home.searchProc}</a>
    </article>

    @foreach (groups as group)
      <article class="p-6 bg-[var(--panel-2)] border border-[var(--line)] rounded-[10px]">
        <p class="mega-col-title">{{ group.label }}</p>
        <p class="mt-1.5 leading-relaxed text-[0.9rem] text-[var(--text-2)]">{{ group.blurb }}</p>
        <ul class="mt-3 p-0 space-y-1 list-none">
          @foreach (group.items as item)
            <li><a href="/features/{{ item.slug }}" class="no-underline text-[0.875rem] text-[var(--text)] hover:text-[var(--accent)]">{{ item.name }}</a></li>
          @endforeach
        </ul>
      </article>
    @endforeach
  </div>
</section>

<!-- Use-case rail: horizontal scroll-snap, so sixteen operations do not become
    a sixteen-row list. -->
<section class="py-20 md:py-28 bg-[var(--bg-2)] border-[var(--line)] border-y reveal">
  <div class="mx-auto px-5 max-w-[1240px]">
    <div class="flex flex-wrap gap-4 items-end justify-between">
      <h2 class="max-w-[22ch] text-[1.9rem] md:text-[2.4rem]">{t:home.railTitle}</h2>
      <a href="/use-cases" class="btn btn-ghost">{t:cta.allUseCases}</a>
    </div>
  </div>

  <div class="overflow-x-auto mt-8 snap-mandatory snap-x" style="scrollbar-width:none">
    <div class="flex gap-4 pb-2 px-5 w-max">
      @foreach (useCases as u)
        <a href="/use-cases/{{ u.slug }}" class="shrink-0 p-6 w-[19rem] no-underline bg-[var(--panel)] border border-[var(--line)] rounded-[10px] hover:border-[var(--accent)] transition-colors snap-start">
          <p class="mega-col-title">{{ u.tagline }}</p>
          <h3 class="mt-2 text-[1.1rem]">{{ u.name }}</h3>
          <p class="mt-2 leading-relaxed text-[0.88rem] text-[var(--text-2)]">{{ u.summary }}</p>
          <p class="mt-4 text-[0.75rem] text-[var(--text-3)] telemetry">{{ u.scale }}</p>
        </a>
      @endforeach
    </div>
  </div>
</section>

<!-- What we do not claim. Two columns of plain text, no cards. -->
<section class="mx-auto px-5 py-20 md:py-28 max-w-[1240px] reveal">
  <h2 class="max-w-[16ch] text-[1.9rem] md:text-[2.4rem]">{t:home.limitsTitle}</h2>
  <div class="grid gap-8 md:grid-cols-2 mt-8">
    <div class="prose">
      <p>
        Drones do not spray your arable fields. Aerial application of plant protection products is
        prohibited by default under German and EU law, with narrow exemptions, most of them for
        steep vineyard terrain. Our maps are built for the sprayer, spreader and hoe you already
        own and are already permitted to use.
      </p>
      <p>
        We do not publish a savings percentage. What a targeted programme saves depends on your
        weed pressure, your programme and your machine, and any number printed here would be
        someone else's field. What we do publish is the measurement: treated area against total
        area, every pass, on your fields.
      </p>
    </div>
    <div class="prose">
      <p>
        A model that is unsure does not become a recommendation. Detections below the confidence
        threshold go to a human reviewer before they reach you, and every finding carries the score
        it was given, so you can see which calls were close.
      </p>
      <p>
        The figures on this site come from a modelled demonstration field, not a customer's. It is
        labelled wherever it appears, and you can read the whole flight record, detection by
        detection, on the field report page.
      </p>
    </div>
  </div>
</section>

<!-- Close. -->
<section class="mx-auto pb-24 px-5 max-w-[1240px] reveal">
  <div class="grid overflow-hidden md:grid-cols-2 border border-[var(--line)] rounded-[10px]">
    <img src="/images/photos/field-aerial.jpg" alt="Aerial view of a wheat field divided by a track" width="1200" height="900" loading="lazy" class="object-cover h-full min-h-[16rem] w-full">
    <div class="flex flex-col justify-center p-8 md:p-11 bg-[var(--panel)]">
      <h2 class="max-w-[18ch] text-[1.7rem] md:text-[2.1rem]">{t:home.closeTitle}</h2>
      <p class="mt-3 max-w-[44ch] leading-relaxed text-[1rem] text-[var(--text-2)]">
        {t:home.closeBody}
      </p>
      <a href="/contact" class="self-start mt-6 btn btn-primary">{t:cta.book}</a>
    </div>
  </div>
</section>

@endsection
