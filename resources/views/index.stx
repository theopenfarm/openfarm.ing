<script server>
const nodePath = require('node:path')
const catalog = await import(nodePath.join(process.cwd(), 'app/Support/catalog.ts'))
const fieldmap = await import(nodePath.join(process.cwd(), 'app/Support/fieldmap.ts'))

const title = 'Open Farming - drone scouting and targeted treatment for farms'
const description = 'Drones scan the field, the models find the weeds, disease and dry ground, and only the affected square metres get treated. Flights booked by the season, not aircraft bought by the unit.'
const activeNav = ''
const pagePath = '/'

const groups = await catalog.featureGroups()
const useCases = await catalog.allUseCases()
const report = await catalog.fieldReport()

// The hero map is the real prescription: boundary, tramlines, every detection
// and every treatment zone from the seeded flight.
const heroMap = report
  ? fieldmap.renderFieldMap(report, { title: `Weed map of ${report.field}: ${report.detections.length} detections and ${report.zones.length} treatment zones` })
  : ''
const zonesOnlyMap = report
  ? fieldmap.renderFieldMap(report, { title: 'Treatment zones only, without the individual detections', showDetections: false })
  : ''
const untreatedHectares = report ? Number((report.hectares - report.treatedHectares).toFixed(2)) : 0
const untreatedPercent = report ? Number((100 - report.treatedPercent).toFixed(1)) : 0
</script>

@layout('layouts/site')

@section('content')

<!-- Hero: asymmetric split. The headline argues, the map proves. -->
<section class="max-w-[1240px] mx-auto px-5 pt-14 md:pt-20 pb-16 md:pb-24">
  <div class="grid gap-10 lg:gap-14 lg:grid-cols-[1.05fr_1fr] lg:items-center">
    <div>
      <h1 class="enter text-[2.1rem] leading-[1.06] sm:text-[2.5rem] lg:text-[2.9rem]" style="--i:0">
        Most of your field is fine.<br>
        Stop treating it like it isn't.
      </h1>
      <p class="enter text-[1.075rem] text-[var(--text-2)] leading-relaxed mt-5 max-w-[46ch]" style="--i:1">
        Drones scan the crop, the models mark what is actually wrong, and the machine treats only
        the ground that needs it.
      </p>
      <div class="enter flex flex-wrap gap-3 mt-8" style="--i:2">
        <a href="/contact" class="btn btn-primary">Book a field visit</a>
        <a href="/field-report" class="btn btn-ghost">Read a field report</a>
      </div>
    </div>

    <div class="enter" style="--i:3">
      @if (report)
        <figure class="rounded-[10px] border border-[var(--line)] bg-[var(--panel)] p-4 sm:p-5 shadow-[var(--shadow)] m-0">
          <div class="flex items-baseline justify-between gap-4 mb-3">
            <figcaption class="text-[0.82rem] text-[var(--text-2)]">
              <span class="font-semibold text-[var(--text)]">{{ report.field }}</span>, {{ report.crop }}, {{ report.hectares }} ha
            </figcaption>
            <span class="chip">Demonstration field</span>
          </div>
          {!! heroMap !!}
          <div class="flex flex-wrap gap-x-5 gap-y-2 mt-3.5 text-[0.78rem] text-[var(--text-2)]">
            <span class="flex items-center gap-1.5"><span class="legend-swatch" style="background:var(--accent)"></span>Treated: {{ report.treatedHectares }} ha</span>
            <span class="flex items-center gap-1.5"><span class="legend-swatch" style="background:var(--crop-soft);border:1px solid var(--crop)"></span>Left alone: {{ untreatedHectares }} ha</span>
            <span class="telemetry ml-auto">{{ report.detections.length }} detections</span>
          </div>
        </figure>
      @endif
    </div>
  </div>
</section>

<!-- What that one flight measured. Hairline-separated readings, no cards. -->
@if (report)
<section class="border-y border-[var(--line)] bg-[var(--panel)]">
  <div class="max-w-[1240px] mx-auto px-5 py-9 grid gap-y-7 gap-x-8 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="telemetry text-[2rem] font-bold leading-none text-[var(--accent)]">{{ report.treatedPercent }}%</p>
      <p class="text-[0.85rem] text-[var(--text-2)] mt-1.5 max-w-[26ch]">of the field flagged for treatment. The other {{ untreatedPercent }}% was left alone.</p>
    </div>
    <div>
      <p class="telemetry text-[2rem] font-bold leading-none">{{ report.detections.length }}</p>
      <p class="text-[0.85rem] text-[var(--text-2)] mt-1.5 max-w-[26ch]">weeds located to the square metre, each with a species and a confidence score.</p>
    </div>
    <div>
      <p class="telemetry text-[2rem] font-bold leading-none">{{ report.durationMinutes }} min</p>
      <p class="text-[0.85rem] text-[var(--text-2)] mt-1.5 max-w-[26ch]">to fly {{ report.hectares }} hectares at {{ report.resolutionCm }} cm per pixel.</p>
    </div>
    <div>
      <p class="telemetry text-[2rem] font-bold leading-none">{{ report.zones.length }}</p>
      <p class="text-[0.85rem] text-[var(--text-2)] mt-1.5 max-w-[26ch]">treatment zones, exported in the format your terminal already reads.</p>
    </div>
  </div>
</section>
@endif

<!-- The thesis: three moves, hairline separated. -->
<section class="max-w-[1240px] mx-auto px-5 py-20 md:py-28 reveal">
  <h2 class="text-[1.9rem] md:text-[2.4rem] max-w-[18ch]">Scan the block. Mark the problem. Treat the marks.</h2>
  <p class="text-[1.02rem] text-[var(--text-2)] mt-4 max-w-[58ch]">
    Every capability here is a version of the same loop. What changes is the sensor on the aircraft
    and what the model is looking for.
  </p>

  <ol class="grid gap-px bg-[var(--line)] rounded-[10px] overflow-hidden mt-10 md:grid-cols-3 list-none p-0">
    <li class="bg-[var(--panel)] p-7">
      <p class="telemetry text-[0.75rem] text-[var(--accent)] font-semibold">Scan</p>
      <h3 class="text-[1.15rem] mt-2">The aircraft flies a fixed grid</h3>
      <p class="text-[0.92rem] text-[var(--text-2)] leading-relaxed mt-2">
        Same route, same altitude, every flight, so today's imagery is comparable with the last one
        rather than a fresh opinion.
      </p>
    </li>
    <li class="bg-[var(--panel)] p-7">
      <p class="telemetry text-[0.75rem] text-[var(--accent)] font-semibold">Mark</p>
      <h3 class="text-[1.15rem] mt-2">Models locate what is wrong</h3>
      <p class="text-[0.92rem] text-[var(--text-2)] leading-relaxed mt-2">
        Weeds by species, disease by divergence from the field's own history, dry ground by canopy
        temperature. Each finding gets a coordinate and a confidence score.
      </p>
    </li>
    <li class="bg-[var(--panel)] p-7">
      <p class="telemetry text-[0.75rem] text-[var(--accent)] font-semibold">Treat</p>
      <h3 class="text-[1.15rem] mt-2">The machine follows the map</h3>
      <p class="text-[0.92rem] text-[var(--text-2)] leading-relaxed mt-2">
        Findings become zones and zones become a prescription your sprayer, spreader or hoe loads
        directly. Nothing outside a zone is touched.
      </p>
    </li>
  </ol>
</section>

<!-- Capability bento: mixed tile sizes, three treatments (map, photo, tint). -->
<section class="max-w-[1240px] mx-auto px-5 pb-20 md:pb-28 reveal">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <h2 class="text-[1.9rem] md:text-[2.4rem] max-w-[20ch]">Eighteen jobs a drone does better than a walk</h2>
    <a href="/features" class="btn btn-ghost">All capabilities</a>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    @if (report)
      <article class="md:col-span-2 md:row-span-2 rounded-[10px] border border-[var(--line)] bg-[var(--panel)] overflow-hidden flex flex-col">
        <div class="p-6 pb-0">
          <span class="chip">Act</span>
          <h3 class="text-[1.35rem] mt-3">Targeted weed control</h3>
          <p class="text-[0.95rem] text-[var(--text-2)] leading-relaxed mt-2 max-w-[52ch]">
            Cameras find weeds plant by plant. The prescription switches the boom on over
            {{ report.treatedHectares }} hectares instead of all {{ report.hectares }}.
          </p>
        </div>
        <div class="p-6 pt-5 mt-auto">
          {!! zonesOnlyMap !!}
          <a href="/features/targeted-weed-control" class="btn btn-ghost mt-5">How the map is built</a>
        </div>
      </article>
    @endif

    <article class="rounded-[10px] border border-[var(--line)] overflow-hidden bg-[var(--panel)]">
      <img src="/images/photos/drone-over-wheat.jpg" alt="A drone flying low over a wheat crop" width="800" height="533" loading="lazy" class="w-full h-40 object-cover">
      <div class="p-6">
        <span class="chip">Detect</span>
        <h3 class="text-[1.1rem] mt-3">Early disease detection</h3>
        <p class="text-[0.9rem] text-[var(--text-2)] leading-relaxed mt-2">
          Multispectral imaging reads chlorophyll loss days before a symptom is visible from the cab.
        </p>
        <a href="/features/plant-disease-detection" class="text-[0.875rem] font-semibold text-[var(--accent)] no-underline inline-block mt-3">See the flight cadence</a>
      </div>
    </article>

    <article class="rounded-[10px] border border-[var(--line)] bg-[var(--accent-wash)] p-6">
      <span class="chip">Detect</span>
      <h3 class="text-[1.1rem] mt-3">Wildlife detection before mowing</h3>
      <p class="text-[0.9rem] text-[var(--text-2)] leading-relaxed mt-2">
        A thermal search at dawn finds fawns pressed flat in the sward, and marks them live on the
        phone of whoever is walking the field.
      </p>
      <a href="/features/wildlife-rescue" class="text-[0.875rem] font-semibold text-[var(--accent)] no-underline inline-block mt-3">Read the search procedure</a>
    </article>

    @foreach (groups as group)
      <article class="rounded-[10px] border border-[var(--line)] bg-[var(--panel-2)] p-6">
        <p class="mega-col-title">{{ group.label }}</p>
        <p class="text-[0.9rem] text-[var(--text-2)] leading-relaxed mt-1.5">{{ group.blurb }}</p>
        <ul class="mt-3 space-y-1 list-none p-0">
          @foreach (group.items as item)
            <li><a href="/features/{{ item.slug }}" class="text-[0.875rem] text-[var(--text)] no-underline hover:text-[var(--accent)]">{{ item.name }}</a></li>
          @endforeach
        </ul>
      </article>
    @endforeach
  </div>
</section>

<!-- Use-case rail: horizontal scroll-snap, so sixteen operations do not become
     a sixteen-row list. -->
<section class="py-20 md:py-28 border-y border-[var(--line)] bg-[var(--bg-2)] reveal">
  <div class="max-w-[1240px] mx-auto px-5">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-[1.9rem] md:text-[2.4rem] max-w-[22ch]">Set up around your crop, not a generic farm</h2>
      <a href="/use-cases" class="btn btn-ghost">All use cases</a>
    </div>
  </div>

  <div class="mt-8 overflow-x-auto snap-x snap-mandatory" style="scrollbar-width:none">
    <div class="flex gap-4 px-5 pb-2 w-max">
      @foreach (useCases as u)
        <a href="/use-cases/{{ u.slug }}" class="snap-start shrink-0 w-[19rem] rounded-[10px] border border-[var(--line)] bg-[var(--panel)] p-6 no-underline hover:border-[var(--accent)] transition-colors">
          <p class="mega-col-title">{{ u.tagline }}</p>
          <h3 class="text-[1.1rem] mt-2">{{ u.name }}</h3>
          <p class="text-[0.88rem] text-[var(--text-2)] leading-relaxed mt-2">{{ u.summary }}</p>
          <p class="telemetry text-[0.75rem] text-[var(--text-3)] mt-4">{{ u.scale }}</p>
        </a>
      @endforeach
    </div>
  </div>
</section>

<!-- What we do not claim. Two columns of plain text, no cards. -->
<section class="max-w-[1240px] mx-auto px-5 py-20 md:py-28 reveal">
  <h2 class="text-[1.9rem] md:text-[2.4rem] max-w-[16ch]">What we do not claim</h2>
  <div class="grid gap-8 md:grid-cols-2 mt-8">
    <div class="prose">
      <p>
        Drones do not spray your arable fields. Aerial application of plant protection products is
        prohibited by default under German and EU law, with narrow exemptions, most of them for
        steep vineyard terrain. Our maps are built for the sprayer, spreader and hoe you already
        own and are already permitted to use.
      </p>
      <p>
        We do not publish a savings percentage. What a targeted programme saves depends on your
        weed pressure, your programme and your machine, and any number printed here would be
        someone else's field. What we do publish is the measurement: treated area against total
        area, every pass, on your fields.
      </p>
    </div>
    <div class="prose">
      <p>
        A model that is unsure does not become a recommendation. Detections below the confidence
        threshold go to a human reviewer before they reach you, and every finding carries the score
        it was given, so you can see which calls were close.
      </p>
      <p>
        The figures on this site come from a modelled demonstration field, not a customer's. It is
        labelled wherever it appears, and you can read the whole flight record, detection by
        detection, on the field report page.
      </p>
    </div>
  </div>
</section>

<!-- Close. -->
<section class="max-w-[1240px] mx-auto px-5 pb-24 reveal">
  <div class="rounded-[10px] border border-[var(--line)] overflow-hidden grid md:grid-cols-2">
    <img src="/images/photos/field-aerial.jpg" alt="Aerial view of a wheat field divided by a track" width="1200" height="900" loading="lazy" class="w-full h-full min-h-[16rem] object-cover">
    <div class="bg-[var(--panel)] p-8 md:p-11 flex flex-col justify-center">
      <h2 class="text-[1.7rem] md:text-[2.1rem] max-w-[18ch]">Bring us one field and we will fly it</h2>
      <p class="text-[1rem] text-[var(--text-2)] leading-relaxed mt-3 max-w-[44ch]">
        Tell us the crop and the hectares. We walk the block, agree a flight calendar around your
        season, and you get the first report before you commit to anything.
      </p>
      <a href="/contact" class="btn btn-primary mt-6 self-start">Book a field visit</a>
    </div>
  </div>
</section>

@endsection
