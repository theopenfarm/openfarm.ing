<script server>
const nodePath = require('node:path')
const catalog = await import(nodePath.join(process.cwd(), 'app/Support/catalog.ts'))

const title = 'Book a field visit - Open Farming'
const description = 'Tell us the crop and the hectares. We walk the block, agree a flight calendar around your season, and you get the first report before committing to anything.'
const activeNav = 'contact'
const pagePath = '/contact'

// The segment select is built from the catalog so the options stay in step
// with the use cases, and the reply can be specific rather than generic.
const useCases = await catalog.allUseCases()

</script>

@layout('layouts/site')

@section('content')

<section class="mx-auto pb-20 pt-14 px-5 md:pt-20 max-w-[1240px]">
  <div class="grid gap-12 lg:gap-16 lg:grid-cols-[1fr_1.05fr]">
    <div>
      <h1 class="max-w-[16ch] leading-[1.07] text-[2.1rem] sm:text-[2.5rem] lg:text-[2.9rem]">{t:contact.title}</h1>
      <p class="mt-5 max-w-[48ch] leading-relaxed text-[1.075rem] text-[var(--text-2)]">
        {t:contact.lede}
      </p>

      <ol class="mt-9 p-0 list-none border-[var(--line)] border-l-2">
        <li class="relative pb-7 pl-7">
          <span class="absolute left-[-0.4rem] top-[0.4rem] h-3 w-3 bg-[var(--accent)] rounded-[6px]"></span>
          <p class="font-semibold text-[0.97rem]">{t:contact.step1}</p>
          <p class="mt-1 leading-relaxed text-[0.92rem] text-[var(--text-2)]">{t:contact.step1Body}</p>
        </li>
        <li class="relative pb-7 pl-7">
          <span class="absolute left-[-0.4rem] top-[0.4rem] h-3 w-3 bg-[var(--accent)] rounded-[6px]"></span>
          <p class="font-semibold text-[0.97rem]">{t:contact.step2}</p>
          <p class="mt-1 leading-relaxed text-[0.92rem] text-[var(--text-2)]">{t:contact.step2Body}</p>
        </li>
        <li class="relative pl-7">
          <span class="absolute left-[-0.4rem] top-[0.4rem] h-3 w-3 bg-[var(--accent)] rounded-[6px]"></span>
          <p class="font-semibold text-[0.97rem]">{t:contact.step3}</p>
          <p class="mt-1 leading-relaxed text-[0.92rem] text-[var(--text-2)]">{t:contact.step3Body}</p>
        </li>
      </ol>

      <p class="mt-10 max-w-[44ch] leading-relaxed text-[0.9rem] text-[var(--text-2)]">
        {t:contact.writeInstead} <a href="mailto:hello@openfarm.ing" class="font-semibold text-[var(--accent)]">hello@openfarm.ing</a>
      </p>
    </div>

    <div class="p-7 md:p-9 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">
      <!-- Server rendered, so the form exists without JavaScript and for a
          crawler. `action`/`method` make the no-JS path a real submit; the
          client script intercepts and posts in place when it is available. -->
      <form id="book" method="post" action="/api/demo-requests">
        <div class="grid gap-5">
          <div class="grid gap-2">
            <label for="name" class="font-semibold text-[0.88rem]">{t:contact.name}</label>
            <input id="name" name="name" type="text" required autocomplete="name"
              :value="visitName()" @input="e => visitName.set(e.target.value)"
              class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
            <p class="text-[0.78rem] text-[var(--text-3)]">{t:contact.nameHelp}</p>
          </div>

          <div class="grid gap-2">
            <label for="email" class="font-semibold text-[0.88rem]">{t:contact.email}</label>
            <input id="email" name="email" type="email" required autocomplete="email"
              :value="visitEmail()" @input="e => visitEmail.set(e.target.value)"
              class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
          </div>

          <div class="grid gap-2">
            <label for="farm_name" class="font-semibold text-[0.88rem]">{t:contact.holding}</label>
            <input id="farm_name" name="farm_name" type="text" autocomplete="organization"
              :value="farmName()" @input="e => farmName.set(e.target.value)"
              class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="grid gap-2">
              <label for="segment" class="font-semibold text-[0.88rem]">{t:contact.operation}</label>
              <select id="segment" name="segment"
                class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
                @foreach (useCases as u)
                  <option value="{{ u.slug }}">{{ u.name }}</option>
                @endforeach
                <option value="other">{t:contact.somethingElse}</option>
              </select>
            </div>

            <div class="grid gap-2">
              <label for="hectares" class="font-semibold text-[0.88rem]">{t:contact.hectares}</label>
              <input id="hectares" name="hectares" type="number" min="0" step="1" inputmode="numeric"
                :value="hectares()" @input="e => hectares.set(e.target.value)"
                class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px]">
              <p class="text-[0.78rem] text-[var(--text-3)]">{t:contact.hectaresHelp}</p>
            </div>
          </div>

          <div class="grid gap-2">
            <label for="message" class="font-semibold text-[0.88rem]">{t:contact.message}</label>
            <textarea id="message" name="message" rows="4"
              :value="visitMessage()" @input="e => visitMessage.set(e.target.value)"
              class="px-3.5 py-2.5 w-full text-[0.95rem] text-[var(--text)] bg-[var(--bg)] border border-[var(--line)] rounded-[10px] resize-y"></textarea>
          </div>

          <input type="hidden" name="source" value="contact">

          <button type="submit" class="w-full btn btn-primary">{t:cta.book}</button>

          <p class="leading-relaxed text-[0.78rem] text-[var(--text-3)]">
            {t:contact.privacy}
          </p>
        </div>
      </form>
    </div>
  </div>
</section>


@endsection
