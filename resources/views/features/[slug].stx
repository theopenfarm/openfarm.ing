<script server>
const nodePath = require('node:path')
const catalog = await import(nodePath.join(process.cwd(), 'app/Support/catalog.ts'))
const fieldmap = await import(nodePath.join(process.cwd(), 'app/Support/fieldmap.ts'))

// /features/<slug>. Anything outside [a-z0-9-] cannot be a slug we issued, so
// it is stripped rather than passed to a lookup.
const slug = String((typeof params === 'object' && params && params.slug) || '').replace(/[^a-z0-9-]/gi, '')
const feature = await catalog.displayFeature(slug)

const title = feature ? `${feature.name} - Open Farming` : 'Capability not found - Open Farming'
const description = feature ? feature.summary : 'That capability does not exist. Browse all eighteen instead.'
const activeNav = 'features'
const pagePath = `/features/${slug}`

// The related use cases are resolved to full records so the cards can carry
// their own summary rather than a bare slug.
const allUseCases = feature ? await catalog.displayUseCases() : []
const related = feature ? allUseCases.filter(u => feature.useCases.includes(u.slug)) : []
// See the use-case page: the token, so the badge follows the locale.
const categoryLabel = feature ? `{t:groups.features.${feature.category}.label}` : ''

// Weed control is the capability the demonstration flight actually flew, so
// its page shows the real map. Every other capability gets its own visual
// vocabulary from the copy instead of a map that would not be its own.
const report = feature && feature.slug === 'targeted-weed-control' ? await catalog.fieldReport() : null
const detailMap = report
  ? fieldmap.renderFieldMap(report, { title: `Weed map of ${report.field}: ${report.detections.length} detections across ${report.zones.length} treatment zones` })
  : ''

const siblings = feature
  ? (await catalog.displayFeatures()).filter(f => f.category === feature.category && f.slug !== feature.slug).slice(0, 4)
  : []
</script>

@layout('layouts/site')

@section('content')

@if (feature)
  <article>
    <!-- Header: category, name, the line, and the problem it addresses. -->
    <section class="mx-auto pb-10 pt-12 px-5 md:pt-16 max-w-[1240px]">
      <a href="/features" class="no-underline text-[0.85rem] text-[var(--text-2)] hover:text-[var(--text)]">{t:nav.capabilities}</a>
      <div class="grid gap-10 lg:gap-14 lg:grid-cols-[1.1fr_1fr] lg:items-start mt-4">
        <div>
          <span class="chip">{{ categoryLabel }}</span>
          <h1 class="mt-4 leading-[1.07] text-[2.1rem] sm:text-[2.5rem] lg:text-[2.9rem]">{{ feature.name }}</h1>
          <p class="mt-3 font-semibold text-[1.1rem] text-[var(--accent)]">{{ feature.tagline }}</p>
          <p class="mt-4 max-w-[52ch] leading-relaxed text-[1.075rem] text-[var(--text-2)]">{{ feature.summary }}</p>
          <div class="flex flex-wrap gap-3 mt-7">
            <a href="/contact" class="btn btn-primary">Book a field visit</a>
          </div>
        </div>

        <div class="p-6 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">
          <h2 class="text-[1.05rem]">What this costs today</h2>
          <p class="mt-3 leading-relaxed text-[0.95rem] text-[var(--text-2)]">{{ feature.problem }}</p>
        </div>
      </div>
    </section>

    @if (report)
      <section class="py-14 bg-[var(--bg-2)] border-[var(--line)] border-y reveal">
        <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center mx-auto px-5 max-w-[1240px]">
          <div>
            <h2 class="max-w-[20ch] text-[1.7rem] md:text-[2rem]">One flight, {{ report.detections.length }} weeds, {{ report.zones.length }} zones</h2>
            <p class="mt-4 max-w-[48ch] leading-relaxed text-[1rem] text-[var(--text-2)]">
              This is the prescription from the demonstration field, drawn from the flight record
              rather than an illustration. Orange is ground the boom opens over. Everything else
              stays dry.
            </p>
            <dl class="grid gap-x-8 gap-y-5 grid-cols-2 m-0 mt-7">
              <div>
                <dt class="text-[0.8rem] text-[var(--text-3)]">Treated</dt>
                <dd class="m-0 font-bold text-[1.5rem] text-[var(--accent)] telemetry">{{ report.treatedHectares }} ha</dd>
              </div>
              <div>
                <dt class="text-[0.8rem] text-[var(--text-3)]">Field</dt>
                <dd class="m-0 font-bold text-[1.5rem] telemetry">{{ report.hectares }} ha</dd>
              </div>
              <div>
                <dt class="text-[0.8rem] text-[var(--text-3)]">Resolution</dt>
                <dd class="m-0 font-bold text-[1.5rem] telemetry">{{ report.resolutionCm }} cm/px</dd>
              </div>
              <div>
                <dt class="text-[0.8rem] text-[var(--text-3)]">Flight time</dt>
                <dd class="m-0 font-bold text-[1.5rem] telemetry">{{ report.durationMinutes }} min</dd>
              </div>
            </dl>
            <a href="/field-report" class="mt-7 btn btn-ghost">Read the full flight record</a>
          </div>
          <figure class="m-0 p-5 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">
            {!! detailMap !!}
            <figcaption class="mt-3 text-[0.78rem] text-[var(--text-3)]">
              {{ report.field }}, {{ report.crop }}. Modelled demonstration field.
            </figcaption>
          </figure>
        </div>
      </section>
    @endif

    <!-- How it runs: the steps, then the instruments and outputs side by side. -->
    <section class="mx-auto px-5 py-16 md:py-20 max-w-[1240px] reveal">
      <h2 class="max-w-[20ch] text-[1.7rem] md:text-[2.1rem]">How the flight runs</h2>
      <ol class="grid overflow-hidden gap-px md:grid-cols-2 lg:grid-cols-4 mt-8 p-0 list-none bg-[var(--line)] rounded-[10px]">
        @foreach (feature.steps as step)
          <li class="p-6 bg-[var(--panel)]">
            <p class="font-semibold text-[0.72rem] text-[var(--accent)] tracking-[0.1em] uppercase telemetry">{{ step.title }}</p>
            <p class="mt-2.5 leading-relaxed text-[0.92rem] text-[var(--text-2)]">{{ step.text }}</p>
          </li>
        @endforeach
      </ol>
    </section>

    <section class="py-14 md:py-16 bg-[var(--panel)] border-[var(--line)] border-y">
      <div class="grid gap-10 md:grid-cols-3 mx-auto px-5 max-w-[1240px]">
        <div>
          <h2 class="text-[1.15rem]">What the aircraft carries</h2>
          <ul class="mt-4 p-0 space-y-2.5 list-none">
            @foreach (feature.sensors as sensor)
              <li class="pl-4 leading-relaxed text-[0.92rem] text-[var(--text-2)] border-[var(--line)] border-l-2">{{ sensor }}</li>
            @endforeach
          </ul>
          <p class="mt-6 text-[0.78rem] text-[var(--text-3)] telemetry">{{ feature.cadence }}</p>
        </div>

        <div>
          <h2 class="text-[1.15rem]">What you receive</h2>
          <ul class="mt-4 p-0 space-y-2.5 list-none">
            @foreach (feature.outputs as output)
              <li class="pl-4 leading-relaxed text-[0.92rem] text-[var(--text-2)] border-[var(--accent)] border-l-2">{{ output }}</li>
            @endforeach
          </ul>
        </div>

        <div>
          <h2 class="text-[1.15rem]">What it measures</h2>
          <p class="mt-1.5 leading-relaxed text-[0.85rem] text-[var(--text-3)]">
            Readings this capability produces on your fields. Measurements, not promises.
          </p>
          <ul class="mt-4 p-0 space-y-2.5 list-none">
            @foreach (feature.readings as reading)
              <li class="pl-4 leading-relaxed text-[0.92rem] text-[var(--text-2)] border-[var(--line)] border-l-2">{{ reading }}</li>
            @endforeach
          </ul>
        </div>
      </div>
    </section>

    <!-- Where it does the most work. -->
    <section class="mx-auto px-5 py-16 md:py-20 max-w-[1240px] reveal">
      <div class="flex flex-wrap gap-4 items-end justify-between">
        <h2 class="max-w-[22ch] text-[1.7rem] md:text-[2.1rem]">Where this carries the most weight</h2>
        <a href="/use-cases" class="btn btn-ghost">All use cases</a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mt-8 p-0 list-none">
        @foreach (related as u)
          <li>
            <a href="/use-cases/{{ u.slug }}" class="block p-6 h-full no-underline bg-[var(--panel)] border border-[var(--line)] rounded-[10px] hover:border-[var(--accent)] transition-colors">
              <h3 class="text-[1.05rem]">{{ u.name }}</h3>
              <p class="mt-2 leading-relaxed text-[0.88rem] text-[var(--text-2)]">{{ u.summary }}</p>
              <p class="mt-4 text-[0.75rem] text-[var(--text-3)] telemetry">{{ u.scale }}</p>
            </a>
          </li>
        @endforeach
      </ul>
    </section>

    <section class="mx-auto pb-20 px-5 max-w-[1240px]">
      <div class="pt-8 border-[var(--line)] border-t">
        <p class="mega-col-title">{t:detail.moreIn} {{ categoryLabel }}</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 mt-3 p-0 list-none">
          @foreach (siblings as s)
            <li><a href="/features/{{ s.slug }}" class="no-underline text-[0.95rem] text-[var(--text-2)] hover:text-[var(--accent)]">{{ s.name }}</a></li>
          @endforeach
        </ul>
      </div>
    </section>
  </article>
@else
  <section class="mx-auto px-5 py-24 max-w-[1240px]">
    <h1 class="text-[2rem]">That capability does not exist</h1>
    <p class="mt-3 max-w-[52ch] leading-relaxed text-[1.05rem] text-[var(--text-2)]">
      The link may be out of date. All eighteen capabilities are listed on one page.
    </p>
    <a href="/features" class="mt-6 btn btn-primary">See all capabilities</a>
  </section>
@endif

@endsection
