<script server>
const nodePath = require('node:path')
const catalog = await import(nodePath.join(process.cwd(), 'app/Support/catalog.ts'))
const fieldmap = await import(nodePath.join(process.cwd(), 'app/Support/fieldmap.ts'))

const title = 'Field report - Open Farming'
const description = 'The full flight record for a demonstration field: 98 weed detections, 62 treatment zones, and 4.34 of 24.6 hectares flagged for treatment.'
const activeNav = 'field-report'
const pagePath = '/field-report'

const report = await catalog.fieldReport()
const subscribeSource = 'field-report'

// The switcher rather than the bare map: this page is the full record, so if
// the flight brought back a stitched image of the ground it belongs here,
// under the same detections. Falls back to the plain map when there is none.
const fullMap = report ? fieldmap.renderFieldMapSwitch(report, { title: `Weed map of ${report.field} with detections and treatment zones` }) : ''
const treatedBar = report ? fieldmap.renderTreatedBar(report) : ''

// The detection table would be 98 rows, which is a data dump rather than a
// report. The severity summary answers the question people actually have,
// and the API serves the full list for anyone who wants every row.
const severityOrder = ['high', 'medium', 'low']
const bySeverity = report
  ? severityOrder.map(level => ({
      level,
      count: report.detections.filter(d => d.severity === level).length,
      area: Math.round(report.detections.filter(d => d.severity === level).reduce((sum, d) => sum + d.area_m2, 0)),
    }))
  : []

const totalWeedArea = report ? Math.round(report.detections.reduce((sum, d) => sum + d.area_m2, 0)) : 0
const meanConfidence = report && report.detections.length > 0
  ? Number((report.detections.reduce((sum, d) => sum + d.confidence, 0) / report.detections.length * 100).toFixed(1))
  : 0
const untreatedHectares = report ? Number((report.hectares - report.treatedHectares).toFixed(2)) : 0
const topSpecies = report ? report.speciesBreakdown : []
const maxSpeciesCount = topSpecies.length > 0 ? topSpecies[0].count : 1
const speciesRows = topSpecies.map(s => ({ ...s, width: Math.round((s.count / maxSpeciesCount) * 100) }))
</script>

@layout('layouts/site')

@section('content')

@if (report)
<section class="mx-auto pb-10 pt-14 px-5 md:pt-20 max-w-[1240px]">
  <span class="chip">{t:fieldReport.sample}</span>
  <h1 class="mt-4 max-w-[22ch] leading-[1.07] text-[2.1rem] sm:text-[2.6rem] lg:text-[3rem]">
    One weed map, every number behind it
  </h1>
  <p class="mt-5 max-w-[62ch] leading-relaxed text-[1.075rem] text-[var(--text-2)]">
    This is the whole record for a single flight: what was flown, what was found and what the
    prescription asked the machine to do. The field is modelled rather than a customer's, and the
    same records are served by the public API.
  </p>
</section>

<!-- Flight header, hairline separated. -->
<section class="bg-[var(--panel)] border-[var(--line)] border-y">
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4 mx-auto px-5 py-8 max-w-[1240px]">
    <div>
      <p class="text-[0.78rem] text-[var(--text-3)]">{t:fieldReport.holding}</p>
      <p class="mt-1 font-semibold text-[1.05rem]">{{ report.farm }}</p>
      <p class="text-[0.85rem] text-[var(--text-2)]">{{ report.region }}</p>
    </div>
    <div>
      <p class="text-[0.78rem] text-[var(--text-3)]">Field</p>
      <p class="mt-1 font-semibold text-[1.05rem]">{{ report.field }}</p>
      <p class="text-[0.85rem] text-[var(--text-2)]">{{ report.crop }}, {{ report.hectares }} ha</p>
    </div>
    <div>
      <p class="text-[0.78rem] text-[var(--text-3)]">Flown</p>
      <p class="mt-1 font-semibold text-[1.05rem] telemetry">{{ report.flownAt }}</p>
      <p class="text-[0.85rem] text-[var(--text-2)]">{{ report.durationMinutes }} {t:fieldReport.minutesAirborne}</p>
    </div>
    <div>
      <p class="text-[0.78rem] text-[var(--text-3)]">{t:fieldReport.resolution}</p>
      <p class="mt-1 font-semibold text-[1.05rem] telemetry">{{ report.resolutionCm }} cm/px</p>
      <p class="text-[0.85rem] text-[var(--text-2)]">{t:fieldReport.purpose}</p>
    </div>
  </div>
</section>

<!-- The map, full width, with the treated ratio underneath it. -->
<section class="mx-auto px-5 py-14 md:py-18 max-w-[1240px] reveal">
  <div class="grid gap-10 lg:gap-14 lg:grid-cols-[1.15fr_1fr] lg:items-start">
    <figure class="m-0 p-5 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">
      {!! fullMap !!}
      <figcaption class="flex flex-wrap gap-x-5 gap-y-2 mt-4 text-[0.8rem] text-[var(--text-2)]">
        <span class="flex gap-1.5 items-center"><span class="legend-swatch" style="background:var(--accent)"></span>{t:fieldReport.legendZone}</span>
        <span class="flex gap-1.5 items-center"><span class="legend-swatch" style="background:var(--accent);border-radius:50%"></span>{t:fieldReport.legendDetection}</span>
        <span class="flex gap-1.5 items-center"><span class="legend-swatch" style="background:var(--crop-soft);border:1px solid var(--crop)"></span>{t:fieldReport.legendCrop}</span>
      </figcaption>
    </figure>

    <div>
      <h2 class="text-[1.6rem]">{t:fieldReport.prescription}</h2>
      <div class="mt-5">
        {!! treatedBar !!}
        <div class="flex justify-between mt-2 text-[0.82rem]">
          <span class="font-semibold text-[var(--accent)]">{{ report.treatedHectares }} ha treated</span>
          <span class="text-[var(--text-2)]">{{ untreatedHectares }} ha left alone</span>
        </div>
      </div>

      <dl class="grid gap-x-8 gap-y-6 grid-cols-2 m-0 mt-8">
        <div>
          <dt class="text-[0.8rem] text-[var(--text-3)]">{t:fieldReport.treatedShare}</dt>
          <dd class="m-0 font-bold text-[1.7rem] text-[var(--accent)] telemetry">{{ report.treatedPercent }}%</dd>
        </div>
        <div>
          <dt class="text-[0.8rem] text-[var(--text-3)]">{t:fieldReport.zones}</dt>
          <dd class="m-0 font-bold text-[1.7rem] telemetry">{{ report.zones.length }}</dd>
        </div>
        <div>
          <dt class="text-[0.8rem] text-[var(--text-3)]">{t:fieldReport.detections}</dt>
          <dd class="m-0 font-bold text-[1.7rem] telemetry">{{ report.detections.length }}</dd>
        </div>
        <div>
          <dt class="text-[0.8rem] text-[var(--text-3)]">{t:fieldReport.confidence}</dt>
          <dd class="m-0 font-bold text-[1.7rem] telemetry">{{ meanConfidence }}%</dd>
        </div>
      </dl>

      <p class="mt-7 max-w-[46ch] leading-relaxed text-[0.9rem] text-[var(--text-2)]">
        Total mapped weed area was {{ totalWeedArea }} m². The prescription covers more ground than
        that because a boom cannot switch at the square metre: zones are built on a grid its section
        control can actually resolve.
      </p>
    </div>
  </div>
</section>

<!-- Species and severity. Two small tables, one hairline each, not per row. -->
<section class="py-14 md:py-18 bg-[var(--bg-2)] border-[var(--line)] border-y">
  <div class="grid gap-12 md:gap-16 md:grid-cols-2 mx-auto px-5 max-w-[1240px]">
    <div>
      <h2 class="text-[1.4rem]">{t:fieldReport.found}</h2>
      <ul class="mt-5 p-0 space-y-4 list-none">
        @foreach (speciesRows as s)
          <li>
            <div class="flex gap-4 items-baseline justify-between">
              <span class="font-semibold text-[0.97rem]">{{ s.label }}</span>
              <span class="text-[0.9rem] text-[var(--text-2)] telemetry">{{ s.count }}</span>
            </div>
            <div class="mt-1.5 h-1.5 bg-[var(--accent)] rounded-[3px]" style="width: {{ s.width }}%"></div>
          </li>
        @endforeach
      </ul>
    </div>

    <div>
      <h2 class="text-[1.4rem]">{t:fieldReport.severity}</h2>
      <p class="mt-1.5 max-w-[44ch] leading-relaxed text-[0.88rem] text-[var(--text-3)]">
        Severity follows mapped area: over 900 m² is high, over 260 m² is medium.
      </p>
      <ul class="mt-5 p-0 list-none divide-[var(--line)] divide-y">
        @foreach (bySeverity as row)
          <li class="flex gap-4 items-baseline justify-between py-3">
            <span class="capitalize font-semibold text-[0.97rem]">{{ row.level }}</span>
            <span class="text-[0.9rem] text-[var(--text-2)] telemetry">{{ row.count }} detections, {{ row.area }} m²</span>
          </li>
        @endforeach
      </ul>
    </div>
  </div>
</section>

<section class="mx-auto px-5 py-16 md:py-20 max-w-[1240px] reveal">
  <div class="grid gap-10 lg:gap-14 lg:grid-cols-2">
    <div class="prose">
      <h2 class="mb-4 text-[1.6rem]">{t:fieldReport.readYourself}</h2>
      <p>
        Every record on this page is served by the public API: the flight, all
        {{ report.detections.length }} detections with their coordinates and confidence scores, and
        the prescription's zone geometry. No key required.
      </p>
      <p>
        The dataset is generated deterministically, so the figures here, in the database and in the
        API are always the same numbers. If they ever disagree, one of them is a bug.
      </p>
    </div>
    <div class="p-6 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">
      <p class="font-bold text-[1.05rem]">{t:fieldReport.getNext}</p>
      <p class="mt-1.5 leading-relaxed text-[0.9rem] text-[var(--text-2)]">
        We publish what the flights are finding as each window opens. A few times a season.
      </p>
      @include('subscribe.stx')

      <p class="mt-8 mega-col-title">{t:fieldReport.endpoints}</p>
      <ul class="mt-3 p-0 space-y-2.5 list-none">
        <li><a href="/api/field-report" class="no-underline text-[0.88rem] text-[var(--accent)] telemetry">/api/field-report</a></li>
        <li><a href="/api/features" class="no-underline text-[0.88rem] text-[var(--accent)] telemetry">/api/features</a></li>
        <li><a href="/api/use-cases" class="no-underline text-[0.88rem] text-[var(--accent)] telemetry">/api/use-cases</a></li>
      </ul>
      <a href="/contact" class="mt-6 w-full btn btn-primary">{t:fieldReport.bookFlight}</a>
    </div>
  </div>
</section>
@else
<section class="mx-auto px-5 py-24 max-w-[1240px]">
  <h1 class="text-[2rem]">{t:fieldReport.noRecord}</h1>
  <p class="mt-3 max-w-[52ch] leading-relaxed text-[1.05rem] text-[var(--text-2)]">
    The demonstration dataset has not been seeded on this instance. Run
    <span class="telemetry">buddy catalog:sync</span> {t:fieldReport.loadIt}
  </p>
  <a href="/" class="mt-6 btn btn-primary">{t:fieldReport.backToStart}</a>
</section>
@endif

@endsection
