<script server>
const nodePath = require('node:path')
const catalog = await import(nodePath.join(process.cwd(), 'app/Support/catalog.ts'))
const fieldmap = await import(nodePath.join(process.cwd(), 'app/Support/fieldmap.ts'))

const title = 'How it works - Open Farming'
const description = 'The loop, in order: an aircraft flies a fixed route, models locate the problem, the findings become a prescription, and the machine you already own treats only the marked ground.'
const activeNav = 'how-it-works'
const pagePath = '/how-it-works'

const report = await catalog.fieldReport()

// Each stage of the loop shows the same field with one more layer switched on,
// so the reader watches the prescription being built rather than reading about
// it. Same data every time; only the layer selection changes.
const stageScan = report ? fieldmap.renderFieldMap(report, { title: 'The field boundary and the tramline corridors the sprayer runs on', showDetections: false, showZones: false }) : ''
const stageDetect = report ? fieldmap.renderFieldMap(report, { title: 'Every weed detection from the flight, sized by mapped area', showZones: false }) : ''
const stageZones = report ? fieldmap.renderFieldMap(report, { title: 'Detections clustered into the treatment zones a boom can resolve', showDetections: false }) : ''
const stageTreat = report ? fieldmap.renderFieldMap(report, { title: 'The finished prescription: zones over detections' }) : ''
</script>

@layout('layouts/site')

@section('content')

<section class="mx-auto pb-12 pt-14 px-5 md:pt-20 max-w-[1240px]">
  <h1 class="max-w-[19ch] leading-[1.07] text-[2.1rem] sm:text-[2.6rem] lg:text-[3rem]">
    Four steps, and a map at the end of them
  </h1>
  <p class="mt-5 max-w-[60ch] leading-relaxed text-[1.075rem] text-[var(--text-2)]">
    Below is the demonstration field with one more layer switched on at each step. Same flight,
    same records, nothing added: this is the prescription being built.
  </p>
</section>

@if (report)
<section class="mx-auto pb-8 px-5 max-w-[1240px]">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <figure class="m-0 reveal">
      <div class="p-3 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">{!! stageScan !!}</div>
      <figcaption class="mt-3">
        <p class="font-semibold text-[0.72rem] text-[var(--accent)] tracking-[0.1em] uppercase telemetry">Fly</p>
        <p class="mt-1.5 leading-relaxed text-[0.9rem] text-[var(--text-2)]">
          The boundary and the tramlines the sprayer already runs on. The aircraft flies the same
          grid every time, so flights compare.
        </p>
      </figcaption>
    </figure>

    <figure class="m-0 reveal">
      <div class="p-3 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">{!! stageDetect !!}</div>
      <figcaption class="mt-3">
        <p class="font-semibold text-[0.72rem] text-[var(--accent)] tracking-[0.1em] uppercase telemetry">Find</p>
        <p class="mt-1.5 leading-relaxed text-[0.9rem] text-[var(--text-2)]">
          {{ report.detections.length }} weeds, each sized by mapped area. Note where they sit:
          headland, tramlines, and two patches that have been building for seasons.
        </p>
      </figcaption>
    </figure>

    <figure class="m-0 reveal">
      <div class="p-3 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">{!! stageZones !!}</div>
      <figcaption class="mt-3">
        <p class="font-semibold text-[0.72rem] text-[var(--accent)] tracking-[0.1em] uppercase telemetry">Zone</p>
        <p class="mt-1.5 leading-relaxed text-[0.9rem] text-[var(--text-2)]">
          Detections clustered onto a grid a boom's section control can actually resolve.
          {{ report.zones.length }} zones, cells under 150 m² of weed left out.
        </p>
      </figcaption>
    </figure>

    <figure class="m-0 reveal">
      <div class="p-3 bg-[var(--panel)] border border-[var(--line)] rounded-[10px]">{!! stageTreat !!}</div>
      <figcaption class="mt-3">
        <p class="font-semibold text-[0.72rem] text-[var(--accent)] tracking-[0.1em] uppercase telemetry">Treat</p>
        <p class="mt-1.5 leading-relaxed text-[0.9rem] text-[var(--text-2)]">
          The finished prescription: {{ report.treatedHectares }} of {{ report.hectares }} hectares,
          exported for the machine already on your yard.
        </p>
      </figcaption>
    </figure>
  </div>
</section>
@endif

<!-- Who does what. A plain two-column split, no cards. -->
<section class="mt-10 py-16 md:py-20 bg-[var(--panel)] border-[var(--line)] border-y">
  <div class="grid gap-10 md:gap-14 md:grid-cols-2 mx-auto px-5 max-w-[1240px]">
    <div>
      <h2 class="text-[1.6rem]">{t:howItWorks.weBring}</h2>
      <ul class="mt-5 p-0 space-y-3 list-none">
        <li class="pl-4 leading-relaxed text-[0.97rem] text-[var(--text-2)] border-[var(--accent)] border-l-2">{t:howItWorks.bring1}</li>
        <li class="pl-4 leading-relaxed text-[0.97rem] text-[var(--text-2)] border-[var(--accent)] border-l-2">{t:howItWorks.bring2}</li>
        <li class="pl-4 leading-relaxed text-[0.97rem] text-[var(--text-2)] border-[var(--accent)] border-l-2">{t:howItWorks.bring3}</li>
        <li class="pl-4 leading-relaxed text-[0.97rem] text-[var(--text-2)] border-[var(--accent)] border-l-2">{t:howItWorks.bring4}</li>
        <li class="pl-4 leading-relaxed text-[0.97rem] text-[var(--text-2)] border-[var(--accent)] border-l-2">{t:howItWorks.bring5}</li>
      </ul>
    </div>
    <div>
      <h2 class="text-[1.6rem]">{t:howItWorks.yoursTitle}</h2>
      <ul class="mt-5 p-0 space-y-3 list-none">
        <li class="pl-4 leading-relaxed text-[0.97rem] text-[var(--text-2)] border-[var(--line)] border-l-2">{t:howItWorks.yours1}</li>
        <li class="pl-4 leading-relaxed text-[0.97rem] text-[var(--text-2)] border-[var(--line)] border-l-2">{t:howItWorks.yours2}</li>
        <li class="pl-4 leading-relaxed text-[0.97rem] text-[var(--text-2)] border-[var(--line)] border-l-2">{t:howItWorks.yours3}</li>
        <li class="pl-4 leading-relaxed text-[0.97rem] text-[var(--text-2)] border-[var(--line)] border-l-2">{t:howItWorks.yours4}</li>
      </ul>
    </div>
  </div>
</section>

<!-- What we cannot do. -->
<section class="mx-auto px-5 py-16 md:py-20 max-w-[1240px] reveal">
  <h2 class="max-w-[24ch] text-[1.7rem] md:text-[2.1rem]">{t:howItWorks.limits}</h2>
  <div class="grid gap-6 md:gap-12 md:grid-cols-2 mt-6 prose">
    <div>
      <p>
        Weather closes windows. A thermal flight needs the right hour, a photogrammetry survey
        needs light, and wind above the airframe's limit grounds everything. Cancelled flights are
        reported with the reason and rescheduled, not quietly dropped.
      </p>
      <p>
        Aerial application of plant protection products is prohibited by default under German and
        EU law, with narrow exemptions, mostly for steep vineyard terrain. Where an exemption
        applies we can fly the treatment. Everywhere else, the map goes to your machine.
      </p>
    </div>
    <div>
      <p>
        A model output is not a diagnosis. Disease flags say a patch has diverged from the rest of
        the field, and something has to be walked to before a spray decision. The scouting route we
        send exists precisely because that step is not optional.
      </p>
      <p>
        Counting has a margin. A yield estimate is a range that narrows across the season, and we
        publish the range rather than the midpoint, because the midpoint is the part that gets
        quoted and the range is the part that is true.
      </p>
    </div>
  </div>
</section>

<section class="mx-auto pb-24 px-5 max-w-[1240px] reveal">
  <div class="flex flex-wrap gap-6 items-center justify-between p-8 md:p-11 bg-[var(--accent-wash)] border border-[var(--line)] rounded-[10px]">
    <div>
      <h2 class="max-w-[22ch] text-[1.6rem] md:text-[1.9rem]">{t:howItWorks.startOne}</h2>
      <p class="mt-2 max-w-[50ch] leading-relaxed text-[0.98rem] text-[var(--text-2)]">
        You get the report before you commit to a calendar. If the map does not tell you something
        you did not know, there is nothing to sign.
      </p>
    </div>
    <a href="/contact" class="btn btn-primary">Book a field visit</a>
  </div>
</section>

@endsection
