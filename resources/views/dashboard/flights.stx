<script server>
const nodePath = require('node:path')
const session = await import(nodePath.join(process.cwd(), 'app/Support/session.ts'))
const board = await import(nodePath.join(process.cwd(), 'app/Support/dashboard.ts'))
const catalog = await import(nodePath.join(process.cwd(), 'app/Support/catalog.ts'))

const title = 'Flights - Open Farming'
const description = 'What has been flown over your fields, and what is scheduled next.'
const activeNav = 'account'
const pagePath = '/dashboard/flights'
const ogCard = 'account'
const railActive = 'flights'

const farmer = await session.currentUser()
const farm = farmer ? await board.farmFor(Number(farmer.id)) : null

const flights = farm ? await board.flightsFor(farm.id) : []
const fields = farm ? await board.fieldsFor(farm.id) : []
const capabilities = catalog.capabilityOptions()

// Scheduled first: what is coming is the part a farmer can still change.
const upcoming = flights.filter(flight => flight.status === 'scheduled')
const flown = flights.filter(flight => flight.status !== 'scheduled')
</script>

@layout('layouts/site')

@section('content')

@if (farmer && farm)
  <section class="mx-auto px-3 py-6 sm:px-5 max-w-[1500px] console">
    <div class="console-shell">
      @include('dashboard-rail.stx')

      <div class="console-body">
        <header class="console-head">
          <div>
            <h1 class="text-[1.5rem] sm:text-[1.75rem]">{t:dashboard.flightsTitle}</h1>
            <p class="mt-1 text-[0.85rem] text-[var(--text-3)]">{{ farm.name }} · {{ upcoming.length }} {t:flights.scheduled} · {{ flown.length }} {t:flights.flown}</p>
          </div>
        </header>

        <section class="mt-4 console-panel">
          <div class="console-panel-head">
            <h2 class="console-panel-title">{t:flights.bookOne}</h2>
          </div>

          <form method="POST" action="/api/dashboard/flight" class="flight-form">
            <label class="flight-field">
              <span class="flight-label">{t:dashboard.field}</span>
              <select name="field_id" class="flight-input" required>
                @foreach (fields as field)
                  <option value="{{ field.id }}">{{ field.name }} · {{ field.crop }}</option>
                @endforeach
              </select>
            </label>

            <label class="flight-field">
              <span class="flight-label">{t:flights.purpose}</span>
              <select name="purpose" class="flight-input" required>
                @foreach (capabilities as capability)
                  <option value="{{ capability.slug }}">{{ capability.name }}</option>
                @endforeach
              </select>
            </label>

            <button type="submit" class="flight-submit">{t:flights.schedule}</button>
          </form>
        </section>

        <div class="mt-4 console-panels">
          <section class="console-panel">
            <div class="console-panel-head">
              <h2 class="console-panel-title">{t:flights.upcoming}</h2>
              <span class="console-panel-meta">{{ upcoming.length }}</span>
            </div>

            @if (upcoming.length)
              <ul class="console-list">
                @foreach (upcoming as flight)
                  <li class="console-task">
                    <div class="flex gap-3 items-baseline justify-between">
                      <p class="console-row-title">{{ flight.field }}</p>
                      <form method="POST" action="/api/dashboard/flight-cancel">
                        <input type="hidden" name="flight_id" value="{{ flight.id }}">
                        <button type="submit" class="capability-button capability-button-off">{t:flights.cancel}</button>
                      </form>
                    </div>
                    <p class="mt-1 console-row-meta">{{ flight.purpose }} · {{ flight.hectares }} ha</p>
                  </li>
                @endforeach
              </ul>
            @else
              <p class="console-empty">{t:flights.noneScheduled}</p>
            @endif
          </section>

          <section class="console-panel">
            <div class="console-panel-head">
              <h2 class="console-panel-title">{t:flights.history}</h2>
              <span class="console-panel-meta">{{ flown.length }}</span>
            </div>

            @if (flown.length)
              <ul class="console-list">
                @foreach (flown as flight)
                  <li class="console-task">
                    <div class="flex gap-3 items-baseline justify-between">
                      <p class="console-row-title">{{ flight.field }}</p>
                      <p class="console-row-meta">{{ flight.flownOn }}</p>
                    </div>
                    <p class="mt-1 console-row-meta">{{ flight.purpose }} · {{ flight.hectares }} ha · {{ flight.detections }} {t:dashboard.detections} · {{ flight.status }}</p>
                  </li>
                @endforeach
              </ul>
            @else
              <p class="console-empty">{t:dashboard.noFlights}</p>
            @endif
          </section>
        </div>
      </div>
    </div>
  </section>
@else
  <section class="mx-auto pb-24 pt-14 px-5 md:pt-20 max-w-[1240px]">
    <div class="max-w-[46ch]">
      <h1 class="mt-4 leading-[1.07] text-[2.1rem] sm:text-[2.5rem]">{t:account.signedOutTitle}</h1>
      <a href="/login" class="inline-flex items-center mt-8 px-5 py-3 font-semibold no-underline text-[0.95rem] text-white bg-[var(--accent)] rounded-[10px]">{t:auth.signIn}</a>
    </div>
  </section>
@endif

@endsection
