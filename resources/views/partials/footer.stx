<script server>
const footPath = require('node:path')
const footCatalog = await import(footPath.join(process.cwd(), 'app/Support/catalog.ts'))

// The footer lists the capabilities that answer the questions people arrive
// with, not all eighteen: a full dump would be a sitemap, and there is one of
// those at /features.
const footFeatures = (await footCatalog.allFeatures()).slice(0, 6)
const footUseCases = (await footCatalog.allUseCases()).slice(0, 6)
const footYear = 2026
// Which form a signup came from, recorded on the subscriber row.
const subscribeSource = 'footer'
</script>

