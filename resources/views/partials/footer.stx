      <div>
        <p class="mega-col-title">Company</p>
        <ul class="space-y-1.5 mt-2 list-none p-0">
          <li><a href="/how-it-works" class="text-[0.875rem] text-[var(--text-2)] hover:text-[var(--text)] no-underline">How it works</a></li>
