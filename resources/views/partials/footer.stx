            <circle cx="8" cy="9" r="2.1" fill="var(--accent)"/>
            <circle cx="15.5" cy="15" r="1.5" fill="var(--accent)"/>
            <path d="M4.5 19.5 L19.5 4.5" stroke="var(--text)" stroke-width="1.1" stroke-opacity="0.35"/>
          </svg>
          <span class="font-bold tracking-[-0.02em]">Open Farming</span>
        </div>
        <p class="text-[0.9rem] text-[var(--text-2)] leading-relaxed mt-3 max-w-[34ch]">
          Drone scouting, treatment maps and the flights that produce them. You book the calendar,
          we bring the aircraft, the pilots and the paperwork.
        </p>
        <a href="/contact" class="btn btn-ghost mt-5">Book a field visit</a>
      </div>

      <div>
        <p class="mega-col-title">Capabilities</p>
        <ul class="space-y-1.5 mt-2 list-none p-0">
          @foreach (footFeatures as f)
            <li><a href="/features/{{ f.slug }}" class="text-[0.875rem] text-[var(--text-2)] hover:text-[var(--text)] no-underline">{{ f.name }}</a></li>
          @endforeach
          <li><a href="/features" class="text-[0.875rem] font-semibold text-[var(--accent)] no-underline">All capabilities</a></li>
        </ul>
      </div>

      <div>
        <p class="mega-col-title">Use cases</p>
        <ul class="space-y-1.5 mt-2 list-none p-0">
          @foreach (footUseCases as u)
            <li><a href="/use-cases/{{ u.slug }}" class="text-[0.875rem] text-[var(--text-2)] hover:text-[var(--text)] no-underline">{{ u.name }}</a></li>
          @endforeach
          <li><a href="/use-cases" class="text-[0.875rem] font-semibold text-[var(--accent)] no-underline">All use cases</a></li>
        </ul>
