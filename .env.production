# Production environment for openfarm.ing.
#
# Deployed as a tenant on the shared stacks Hetzner box (config/cloud.ts,
# cloud.attachTo: 'stacks'). ts-cloud ships this file to each site as its
# `.env`, merged with the per-site `env` block in config/cloud.ts.
#
# Secrets belong in here as `encrypted:` values written by `buddy env:set`,
# never in plaintext: this file is committed.
APP_NAME="Open Farming"
APP_ENV=production
APP_URL=openfarm.ing
APP_DOMAIN=openfarm.ing
APP_MAINTENANCE=false
APP_COMING_SOON=false
DEBUG=false

# Both services on the box bind loopback; the rpx gateway is the only way in.
PORT=3060
PORT_API=3068

# SQLite lives outside the atomic release directories so the catalog and any
# enquiries survive a deploy.
DB_CONNECTION=sqlite
DB_DATABASE=openfarming
DB_DATABASE_PATH=/var/lib/openfarming/stacks.sqlite

MAIL_FROM_NAME="Open Farming"
MAIL_FROM_ADDRESS="hello@openfarm.ing"

QUEUE_DRIVER=sync
FILESYSTEM_DISK=local
