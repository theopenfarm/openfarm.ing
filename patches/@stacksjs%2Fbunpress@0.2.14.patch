@@ -0,0 +1,23 @@
+// Deployment path compatibility patch for BunPress 0.2.14.
+import { ba as resolveSiteUrl } from './chunk-4r44z49z.js'
+
+export function getConfiguredBasePath(config) {
+  if (config.basePath) {
+    const normalized = config.basePath.trim().replace(/\/+$/, '')
+    if (!normalized || normalized === '/')
+      return ''
+    return normalized.startsWith('/') ? normalized : `/${normalized}`
+  }
+
+  const baseUrl = resolveSiteUrl(config)
+  if (!baseUrl)
+    return ''
+
+  try {
+    const pathname = new URL(baseUrl).pathname.replace(/\/+$/, '')
+    return pathname === '/' ? '' : pathname
+  }
+  catch {
+    return ''
+  }
+}
